<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels"
             xmlns:c="using:Kopru.App.Controls" x:Class="Kopru.App.Views.GamePanelView" x:DataType="vm:GamePanelViewModel">
  <!-- One game's settings (see GamePanelViewModel), shown in the Games page's pop-up: its picture, name and source; Play,
       Hide/Remove; its start file, controller type and profile, sound to haptics; then either "Settings For This Game" or
       that profile's settings. Two columns where there is room, one otherwise; scrolls inside when the window is short.
       Every setting is one row: its label left, its control right in a column of one width (PanelControlWidth) in both
       columns, so pickers, sliders (with their value) and switches line up; groups have a section title like Settings. -->
  <UserControl.Resources>
    <x:Double x:Key="PanelControlWidth">196</x:Double>
    <!-- A segmented choice's option, in the item's colour (muted, bright while selected) -->
    <DataTemplate x:Key="SegmentText" x:DataType="vm:LabelledChoice">
      <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" TextWrapping="NoWrap" />
    </DataTemplate>
    <!-- Sound to haptics: one row named after the setting with its switch (the switch shows on or off; while on, what it is
         doing now is a caption under the name), the note that the game's own rumble is separate, then the strength (with its
         value) and Bass | All Sound (greyed out while the engine cannot capture the sound) -->
    <DataTemplate x:Key="AudioSection" x:DataType="vm:GamePanelViewModel">
      <StackPanel Classes="group" Name="PanelAudio">
        <!-- The switch is never greyed out (it can always be turned off, and on again to try once more) -->
        <Grid Classes="panelRow" Name="PanelAudioRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding AudioHint}">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="label" Name="PanelAudioLabel" Text="{Binding AudioTitle}" />
            <TextBlock Classes="caption" Name="PanelAudioStatus" Text="{Binding AudioHaptics.Status}" IsVisible="{Binding AudioHaptics.On}" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Name="PanelAudioSwitch" IsChecked="{Binding AudioHaptics.On}" OnContent="{x:Null}" OffContent="{x:Null}"
                        AutomationProperties.Name="{Binding AudioTitle}" />
        </Grid>
        <TextBlock Classes="caption" Text="{Binding AudioRumbleNote}" TextWrapping="Wrap" />
        <StackPanel Classes="group" IsEnabled="{Binding AudioHaptics.Available}">
          <Grid Classes="panelRow" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding AudioStrengthLabel}" />
            <Grid Grid.Column="1" Classes="panelControl sliderValue" ColumnDefinitions="*,Auto">
              <Slider Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding AudioHaptics.Strength}"
                      AutomationProperties.Name="{Binding AudioStrengthLabel}" />
              <TextBlock Grid.Column="1" Classes="value" Text="{Binding AudioHaptics.StrengthText}" />
            </Grid>
          </Grid>
          <Grid Classes="panelRow" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding AudioBandLabel}" />
            <ListBox Grid.Column="1" Classes="panelControl" Theme="{StaticResource Segmented}" ItemsSource="{Binding AudioHaptics.BandChoices}"
                     SelectedIndex="{Binding AudioHaptics.BandIndex}" ItemTemplate="{StaticResource SegmentText}" AutoScrollToSelectedItem="False"
                     AutomationProperties.Name="{Binding AudioBandLabel}" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- A setting row: label (wraps) left, the control right, both centred on the row -->
    <Style Selector="Grid.panelRow">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="ColumnSpacing" Value="{StaticResource Gap}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.panelRow > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.panelRow TextBlock.label">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The control column: one width for pickers, sliders, segmented choices and row buttons -->
    <Style Selector=":is(Control).panelControl">
      <Setter Property="Width" Value="{StaticResource PanelControlWidth}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.panelControl">
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- A button that holds a value (the start file): its content from the left, like a picker's -->
    <Style Selector="Button.field">
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- A square icon button at the control column's right end (the profile's actions, removing the start file) -->
    <Style Selector="Button.square">
      <Setter Property="Width" Value="{StaticResource ControlHeight}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.panelControl">
      <Setter Property="c:PopupScrollGuard.Contain" Value="True" />
    </Style>
    <Style Selector="Grid.sliderValue">
      <Setter Property="ColumnSpacing" Value="{StaticResource GapSmall}" />
    </Style>
    <Style Selector="Grid.sliderValue > Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.sliderValue > TextBlock.value">
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <!-- A switch ends on the control column's right edge (its box, not only its knob: no room kept for on/off text) -->
    <Style Selector="Grid.panelRow > ToggleSwitch">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.panelRow > ToggleSwitch /template/ ContentPresenter#PART_OnContentPresenter, Grid.panelRow > ToggleSwitch /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- A group of rows under its section title (the title as on the Settings tabs) -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="StackPanel.group > TextBlock.section">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- The default profile's offer: one quiet box instead of loose lines, starting level with the left column's first row -->
    <Style Selector="Border.offer">
      <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- The game: picture, name, where it comes from, its actions under them; Close. The actions sit here, not atop the
         left column, so both columns start with their first setting, level. -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Gap}" Margin="0,0,0,20">
      <c:GameThumbnail Source="{Binding Game.Image, FallbackValue={x:Null}}" Name="PanelPicture" Width="88" Height="41" CornerRadius="{StaticResource RadiusSmall}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Name="PanelTitle" Classes="h2" Text="{Binding Game.Name, FallbackValue=''}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{Binding SourceText}" TextWrapping="Wrap" />
        <!-- Play (where we know how), or Back To Game while this game runs (the Overview's button), and Hide or Remove -->
        <StackPanel Name="PanelActions" Orientation="Horizontal" Spacing="{StaticResource GapSmall}" Margin="0,8,0,0">
          <Button Name="PanelPlayButton" Theme="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}" Padding="16,0" IsVisible="{Binding Game.ShowsPlay, FallbackValue=False}"
                  Command="{Binding PlayCommand}" Content="{Binding Game.PlayText, FallbackValue=''}" ToolTip.Tip="{Binding Game.PlayTip, FallbackValue=''}" />
          <Button Name="PanelBackToGameButton" Theme="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}" Padding="14,0" IsVisible="{Binding Game.IsRunning, FallbackValue=False}"
                  Command="{Binding BackToGameCommand}" ToolTip.Tip="{Binding Game.BackToGameTip, FallbackValue=''}"
                  AutomationProperties.Name="{Binding BackToGameText}" AutomationProperties.HelpText="{Binding Game.BackToGameTip, FallbackValue=''}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
              <c:IconSlot Data="{x:Static c:IconPaths.Back}" Stroke="White" />
              <TextBlock Text="{Binding BackToGameText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
          <Button Name="PanelHideButton" Theme="{StaticResource QuietButton}" Padding="16,0" IsVisible="{Binding CanHideOrRemove}"
                  Command="{Binding HideOrRemoveCommand}" Content="{Binding HideOrRemoveText}" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="2" Name="ClosePanelButton" Theme="{StaticResource QuietButton}" Padding="14,0" VerticalAlignment="Top"
              Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
    </Grid>
    <ScrollViewer Grid.Row="1" Name="PanelScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Two columns where the dialog is wide (the game, its start, type and profile, and sound to haptics left; its feel
           settings right), one column otherwise (see the code-behind) -->
      <Grid Name="PanelColumns" Margin="0,0,12,0">
        <StackPanel Name="PanelLeft" Spacing="16">
          <!-- The start file (for games we can't start, or instead of our way), controller type and profile: the row's choices -->
          <StackPanel Classes="group">
            <!-- Like a picker: a folder and "Choose File…", or the chosen file's name (click to change) with a remove button
                 at the row's end -->
            <Grid Classes="panelRow" Name="StartFileRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding StartFileTip}">
              <TextBlock Classes="label" Text="{Binding StartFileLabel}" />
              <Button Grid.Column="1" Name="ChooseStartFileButton" Classes="panelControl field" Theme="{StaticResource QuietButton}" IsVisible="{Binding HasNoStartFile}"
                      Command="{Binding ChooseStartFileCommand}" ToolTip.Tip="{Binding StartFileHint}" AutomationProperties.Name="{Binding ChooseStartFileText}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                  <c:IconSlot Data="{x:Static c:IconPaths.Folder}" Size="16" Stroke="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StartFilePickText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                </StackPanel>
              </Button>
              <Grid Grid.Column="1" Name="StartFileControl" Classes="panelControl" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapSmall}" IsVisible="{Binding HasStartFile}">
                <Button Name="ChangeStartFileButton" Classes="field" Theme="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinWidth="0"
                        Command="{Binding ChooseStartFileCommand}" ToolTip.Tip="{Binding StartFileTip}" AutomationProperties.Name="{Binding ChangeStartFileText}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapSmall}">
                    <c:IconSlot Data="{x:Static c:IconPaths.Folder}" Size="16" Stroke="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Name="StartFileName" Text="{Binding StartFileName}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
                <Button Grid.Column="1" Name="RemoveStartFileButton" Classes="square" Theme="{StaticResource QuietButton}" Command="{Binding RemoveStartFileCommand}"
                        ToolTip.Tip="{Binding RemoveStartFileText}" AutomationProperties.Name="{Binding RemoveStartFileText}">
                  <c:IconSlot Data="{x:Static c:IconPaths.Cross}" Size="16" Stroke="{StaticResource TextBrush}" />
                </Button>
              </Grid>
            </Grid>
            <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Game.PadType.Tip, FallbackValue=''}">
              <TextBlock Classes="label" Text="{Binding PadTypeLabel}" />
              <ComboBox Grid.Column="1" Name="PanelPadType" Classes="panelControl" ItemsSource="{Binding Game.PadType.Options, FallbackValue={x:Null}}"
                        SelectedItem="{Binding Game.PadType.Selected, FallbackValue={x:Null}}" AutomationProperties.Name="{Binding PadTypeLabel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadTypeOption"><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Line}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <!-- The profile (switches live while the game runs) and its actions: New Profile, Rename, Duplicate -->
            <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Game.Profile.Tip, FallbackValue=''}">
              <TextBlock Classes="label" Text="{Binding ProfileLabel}" />
              <!-- Picker and actions share the control column: the picker from its left edge, the actions at its right end
                   (like the start file's remove button) -->
              <Grid Grid.Column="1" Name="PanelProfileControl" Classes="panelControl" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapSmall}">
                <ComboBox Name="PanelProfile" HorizontalAlignment="Stretch" c:PopupScrollGuard.Contain="True" ItemsSource="{Binding Game.Profile.Options, FallbackValue={x:Null}}"
                          SelectedItem="{Binding Game.Profile.Selected, FallbackValue={x:Null}}" AutomationProperties.Name="{Binding ProfileLabel}">
                  <ComboBox.ItemTemplate>
                    <!-- A long name ends in "…" in the fixed-width picker; the full name is its tooltip -->
                    <DataTemplate x:DataType="vm:ProfileOption"><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Name="PanelProfileActions" Classes="square" Theme="{StaticResource QuietButton}"
                        ToolTip.Tip="{Binding ProfileActionsText}" AutomationProperties.Name="{Binding ProfileActionsText}">
                  <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextBrush}" />
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextBrush}" />
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextBrush}" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Name="PanelNewProfile" Header="{Binding NewProfileText}" Command="{Binding NewProfileCommand}" />
                      <MenuItem Name="PanelRenameProfile" Header="{Binding RenameProfileText}" Command="{Binding RenameProfileCommand}" />
                      <MenuItem Name="PanelDuplicateProfile" Header="{Binding DuplicateProfileText}" Command="{Binding DuplicateProfileCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Grid>
            <!-- The new or renamed profile's name (the game's name to start with, selected): Enter saves, Esc cancels -->
            <Grid Classes="panelRow" Name="ProfileNameRow" ColumnDefinitions="*,Auto" IsVisible="{Binding IsNaming}">
              <TextBlock Classes="label" Text="{Binding NamingLabel}" />
              <TextBox Grid.Column="1" Name="ProfileNameBox" Classes="panelControl" Text="{Binding ProfileName}" MaxLength="40"
                       AutomationProperties.Name="{Binding NamingLabel}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SaveProfileNameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
            <Grid Classes="panelRow" Name="ProfileNameButtons" ColumnDefinitions="*,Auto" IsVisible="{Binding IsNaming}">
              <Grid Grid.Column="1" Classes="panelControl" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource GapSmall}">
                <Button Classes="panelControl" Name="SaveProfileNameButton" Theme="{StaticResource PrimaryButton}" Width="NaN" HorizontalAlignment="Stretch"
                        Command="{Binding SaveProfileNameCommand}" Content="{Binding SaveText}" />
                <Button Grid.Column="1" Classes="panelControl" Theme="{StaticResource QuietButton}" Width="NaN" HorizontalAlignment="Stretch"
                        Command="{Binding CancelProfileNameCommand}" Content="{Binding CancelText}" />
              </Grid>
            </Grid>
          </StackPanel>

          <!-- Sound to haptics (with the game's own settings) -->
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AudioSection}" IsVisible="{Binding HasOwnProfile}" />
        </StackPanel>
        <StackPanel Name="PanelRight" Spacing="16">

          <!-- On the default profile: one box with the state, what the button does and the button -->
          <Border Name="OwnSettingsOffer" Classes="offer" IsVisible="{Binding UsesDefault}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{Binding UsesDefaultText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding OwnSettingsHint}" TextWrapping="Wrap" />
              </StackPanel>
              <!-- Quiet like Back To Default, its counterpart; Play is the pop-up's one primary button -->
              <Button Name="OwnSettingsButton" Theme="{StaticResource QuietButton}" Padding="14,0" HorizontalAlignment="Left"
                      Command="{Binding UseOwnSettingsCommand}" Content="{Binding OwnSettingsText}" />
            </StackPanel>
          </Border>

          <!-- The game's own profile: its name and Back To Default, then its settings -->
          <StackPanel Name="OwnSettings" Spacing="16" IsVisible="{Binding HasOwnProfile}">
            <!-- As tall as a setting row, so its button sits level with the left column's first control -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}" MinHeight="36">
              <TextBlock Classes="h2" Text="{Binding ProfileLine}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Name="ResetButton" Theme="{StaticResource QuietButton}" Padding="14,0" Command="{Binding ResetToDefaultCommand}"
                      Content="{Binding ResetText}" ToolTip.Tip="{Binding ResetHint}" />
            </Grid>

            <!-- The game's own effects (supported games) -->
            <StackPanel Name="PanelGameEffects" Classes="group" IsVisible="{Binding IsSupported}">
              <TextBlock Classes="section" Text="{Binding Feel.GameCardTitle}" />
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.GameHapticsHint}">
                <TextBlock Classes="label" Text="{Binding Feel.GameHapticsLabel}" />
                <Grid Grid.Column="1" Classes="panelControl sliderValue" ColumnDefinitions="*,Auto">
                  <Slider Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Feel.GameHapticsLevel}" AutomationProperties.Name="{Binding Feel.GameHapticsLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Feel.GameHapticsText}" />
                </Grid>
              </Grid>
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.TriggerHint}">
                <TextBlock Classes="label" Text="{Binding Feel.TriggerLabel}" />
                <Grid Grid.Column="1" Classes="panelControl sliderValue" ColumnDefinitions="*,Auto">
                  <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Feel.TriggerStrength}" AutomationProperties.Name="{Binding Feel.TriggerLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Feel.TriggerStrengthText}" />
                </Grid>
              </Grid>
            </StackPanel>

            <!-- Classic rumble: level, feel, the fallback trigger effect and its strength -->
            <StackPanel Name="PanelClassicRumble" Classes="group">
              <TextBlock Classes="section" Text="{Binding Feel.RumbleCardTitle}" />
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.RumbleHint}">
                <TextBlock Classes="label" Text="{Binding Feel.RumbleLabel}" />
                <Grid Grid.Column="1" Classes="panelControl sliderValue" ColumnDefinitions="*,Auto">
                  <Slider Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Feel.RumbleLevel}" AutomationProperties.Name="{Binding Feel.RumbleLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Feel.RumbleText}" />
                </Grid>
              </Grid>
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.FeelHint}">
                <TextBlock Classes="label" Text="{Binding Feel.FeelLabel}" />
                <ListBox Grid.Column="1" Classes="panelControl" Theme="{StaticResource Segmented}" ItemsSource="{Binding Feel.FeelChoices}"
                         SelectedIndex="{Binding Feel.FeelIndex}" ItemTemplate="{StaticResource SegmentText}" AutoScrollToSelectedItem="False"
                         AutomationProperties.Name="{Binding Feel.FeelLabel}" />
              </Grid>
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.FallbackHint}">
                <TextBlock Classes="label" Text="{Binding Feel.FallbackLabel}" />
                <ComboBox Grid.Column="1" Name="PanelFallback" Classes="panelControl" ItemsSource="{Binding Feel.FallbackChoices}" SelectedIndex="{Binding Feel.FallbackIndex}"
                          AutomationProperties.Name="{Binding Feel.FallbackLabel}" />
              </Grid>
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" IsEnabled="{Binding Feel.HasFallback}" ToolTip.Tip="{Binding Feel.FallbackStrengthHint}">
                <TextBlock Classes="label" Text="{Binding Feel.FallbackStrengthLabel}" />
                <Grid Grid.Column="1" Classes="panelControl sliderValue" ColumnDefinitions="*,Auto">
                  <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Feel.FallbackStrength}" AutomationProperties.Name="{Binding Feel.FallbackStrengthLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Feel.FallbackStrengthText}" />
                </Grid>
              </Grid>
              <!-- Trigger Rumble (only the Xbox Series type sends it; the tooltip says so), while the experimental setting is on -->
              <Grid Classes="panelRow" Name="PanelTriggerRumbleRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.TriggerRumbleHint}"
                    IsVisible="{Binding Feel.ShowsTriggerRumble}">
                <TextBlock Classes="label" Text="{Binding Feel.TriggerRumbleLabel}" />
                <ComboBox Grid.Column="1" Name="PanelTriggerRumble" Classes="panelControl" ItemsSource="{Binding Feel.TriggerRumbleChoices}" SelectedIndex="{Binding Feel.TriggerRumbleIndex}"
                          AutomationProperties.Name="{Binding Feel.TriggerRumbleLabel}" />
              </Grid>
            </StackPanel>

            <!-- The game's light -->
            <StackPanel Classes="group">
              <TextBlock Classes="section" Text="{Binding LightGroupLabel}" />
              <Grid Classes="panelRow" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Feel.LightHint}">
                <TextBlock Classes="label" Text="{Binding Feel.LightLabel}" />
                <ToggleSwitch Grid.Column="1" Name="PanelLightSwitch" IsChecked="{Binding Feel.LightFromGame}" OnContent="{x:Null}" OffContent="{x:Null}"
                              AutomationProperties.Name="{Binding Feel.LightLabel}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
