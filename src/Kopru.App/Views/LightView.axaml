<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:c="using:Kopru.App.Controls" xmlns:v="using:Kopru.App.Views" x:Class="Kopru.App.Views.LightView" x:DataType="vm:LightViewModel">
  <UserControl.Resources>
    <!-- Choice pill (same look as ChipToggle): the chosen one gets the accent edge and tint -->
    <ControlTheme x:Key="ChoicePill" TargetType="ListBoxItem">
      <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16"
                  Height="{StaticResource ControlHeight}" Padding="12,0">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
      <Style Selector="^:selected:pointerover"><Setter Property="Background" Value="{StaticResource AccentTintHoverBrush}" /></Style>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /></Style>
    </ControlTheme>
    <ItemsPanelTemplate x:Key="Wrap"><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
  </UserControl.Resources>

  <!-- Header in the page column; below it the live preview beside the settings column. Both share one height: the column
       sets it (the stage follows), and when the window is too short the "Your Light" card scrolls while the preview and
       the game light switch stay in view -->
  <Grid RowDefinitions="Auto,16,*" Classes="page">
    <StackPanel Spacing="4">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="body" Text="{Binding Intro}" />
      <v:ControllerSelector DataContext="{Binding Picker}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- The settings column is a little wider than the preview, so its explanations keep to one line and the card fits -->
    <Grid Grid.Row="2" ColumnDefinitions="4*,16,5*" VerticalAlignment="Top">
      <!-- Live preview of the user's own light: the light strips follow the effect, brightness and player LEDs -->
      <Border Classes="stage" Padding="24,20" MinHeight="300">
        <c:ControllerArt IsEdge="{Binding IsEdge}" LightColor="{Binding PreviewColor}" LightIntensity="{Binding Settings.LightIntensity}"
                         PlayerLedMask="{Binding PreviewPlayerMask}" MaxHeight="420" VerticalAlignment="Center" />
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,16,Auto,8,*">
        <!-- Use The Game's Light: the one switch for a game's colour; the reason shows when it can do nothing now -->
        <Border Classes="panel" Padding="20,14" Name="GameLightCard">
          <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding GameLightHint}">
            <StackPanel Spacing="2" Margin="0,0,12,0">
              <TextBlock Classes="h2" Text="{Binding GameLightLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="body" Text="{Binding GameLightHint}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding GameLightOffReason}" IsVisible="{Binding HasGameLightOffReason}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Name="GameLightSwitch" IsChecked="{Binding Settings.LightFromGame}" OnContent="{x:Null}" OffContent="{x:Null}"
                          VerticalAlignment="Center" AutomationProperties.Name="{Binding GameLightLabel}" AutomationProperties.HelpText="{Binding GameLightHint}" />
          </Grid>
        </Border>

        <TextBlock Grid.Row="2" Classes="section" Text="{Binding OwnLightLabel}" />

        <Border Grid.Row="4" Classes="panel" Padding="0" Name="OwnLightCard">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- Each section: title (and hint) on top, its control below; sections split by a divider -->
            <StackPanel Margin="20,4">
              <!-- Mode: a picker on the title's line (four chips wrapped to two lines in English and pushed the card into
                   scrolling), what the mode does under it -->
              <StackPanel Spacing="8" Margin="0,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}">
                  <TextBlock Classes="h2" Text="{Binding ModeLabel}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" Name="LightModePicker" Width="{StaticResource ControlWidthPicker}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                            AutomationProperties.Name="{Binding ModeLabel}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="body" Text="{Binding ModeHint}" />
              </StackPanel>

              <!-- Colour (static, breathing) -->
              <StackPanel IsVisible="{Binding ShowsColour}">
                <Border Classes="divider" />
                <StackPanel Spacing="8" Margin="0,12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{Binding ColourLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SelectedName}" />
                  </Grid>
                  <ListBox Classes="plain" AutoScrollToSelectedItem="False" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                           ItemContainerTheme="{StaticResource SwatchItem}" HorizontalAlignment="Left">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ColourPreset">
                        <Ellipse Fill="{Binding Brush}" ToolTip.Tip="{Binding Name}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </StackPanel>

              <!-- Breathing: one section, three sliders -->
              <StackPanel IsVisible="{Binding ShowsBreathing}">
                <Border Classes="divider" />
                <StackPanel Spacing="14" Margin="0,12">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="{Binding BreathingPeriodLabel}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding BreathingPeriodText}" />
                    </Grid>
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Settings.BreathingPeriod}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="{Binding BreathingMinLabel}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding BreathingMinText}" />
                    </Grid>
                    <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.BreathingMin}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="{Binding BreathingMaxLabel}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding BreathingMaxText}" />
                    </Grid>
                    <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.BreathingMax}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Rainbow -->
              <StackPanel IsVisible="{Binding ShowsRainbow}">
                <Border Classes="divider" />
                <StackPanel Spacing="4" Margin="0,12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{Binding RainbowSpeedLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding RainbowSpeedText}" />
                  </Grid>
                  <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.RainbowSpeed}" />
                </StackPanel>
              </StackPanel>

              <!-- Brightness -->
              <Border Classes="divider" />
              <StackPanel Spacing="4" Margin="0,12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{Binding BrightnessLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Settings.BrightnessText}" />
                </Grid>
                <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.Brightness}" />
              </StackPanel>

              <!-- Player LEDs, with their brightness as a sub-setting: its label and a segmented choice on one line -->
              <Border Classes="divider" />
              <StackPanel Spacing="8" Margin="0,12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="{Binding PlayerLedsLabel}" />
                  <TextBlock Classes="body" Text="{Binding PatternHint}" />
                </StackPanel>
                <ListBox Classes="plain" AutoScrollToSelectedItem="False" ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}"
                         ItemContainerTheme="{StaticResource ChoicePill}" ItemsPanel="{StaticResource Wrap}" Margin="0,0,0,-6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabelledChoice"><TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" TextWrapping="NoWrap" /></DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}" Margin="0,2,0,0">
                  <TextBlock Classes="label" Text="{Binding LedBrightnessLabel}" VerticalAlignment="Center" />
                  <ListBox Grid.Column="1" Name="LedBrightnessChoice" Theme="{StaticResource Segmented}" Width="{StaticResource ControlWidthCompact}" AutoScrollToSelectedItem="False"
                           ItemsSource="{Binding LedLevels}" SelectedItem="{Binding SelectedLedLevel}" AutomationProperties.Name="{Binding LedBrightnessLabel}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LabelledChoice"><TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" TextWrapping="NoWrap" /></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </StackPanel>
              <!-- The mute LED is not a light setting: it always shows the microphone (BridgeHost.SyncMuteLed). -->
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
