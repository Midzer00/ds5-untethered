<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:c="using:Kopru.App.Controls" x:Class="Kopru.App.Views.RemapView" x:DataType="vm:RemapViewModel">
  <StackPanel Spacing="16">
    <TextBlock Classes="body" Text="{Binding Intro}" />

    <!-- Button remapping: physical button -> target, two columns -->
    <Border Classes="panel">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,16,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="{Binding RemapLabel}" />
            <TextBlock Classes="body" Text="{Binding RemapHint}" />
          </StackPanel>
          <Button Grid.Column="2" Theme="{StaticResource QuietButton}" Content="{Binding ResetText}" Command="{Binding ResetRemapCommand}" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RemapRow">
              <Grid ColumnDefinitions="*,12,200" Margin="0,3,28,3">
                <TextBlock Classes="label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ButtonOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- DualSense Edge: back paddles and presentation, only while an Edge is connected -->
    <Border Classes="panel" DataContext="{Binding Edge}" x:DataType="vm:EdgeRemapPanel" IsVisible="{Binding IsVisible}" Name="EdgePanel">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding Hint}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,16,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{Binding PresentAsEdgeLabel}" />
            <TextBlock Classes="caption" Text="{Binding PresentAsEdgeHint}" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding PresentAsEdge}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RemapRow">
              <Grid ColumnDefinitions="*,12,200" Margin="0,3,28,3">
                <TextBlock Classes="label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ButtonOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Gyro aiming: settings on the left, the live offset on the right -->
    <Border Classes="panel">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,16,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="{Binding GyroLabel}" />
            <TextBlock Classes="body" Text="{Binding GyroHint}" />
          </StackPanel>
          <Button Grid.Column="2" Theme="{StaticResource QuietButton}" Content="{Binding ResetText}" Command="{Binding ResetGyroCommand}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,24,Auto">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,24,*">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{Binding ModeLabel}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GyroModeOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom" IsVisible="{Binding HasActivationButton}" ToolTip.Tip="{Binding ToggleHint}">
                <TextBlock Classes="label" Text="{Binding ToggleLabel}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Toggle}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,24,*" IsEnabled="{Binding IsGyroOn}">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{Binding GyroTargetLabel}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GyroTargets}" SelectedItem="{Binding SelectedGyroTarget}" ToolTip.Tip="{Binding GyroTargetHint}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GyroTargetOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding GyroTargetHint}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,12,Auto,12,Auto" IsEnabled="{Binding IsGyroOn}">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{Binding SensitivityXLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding SensitivityXText}" />
                </Grid>
                <Slider Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SensitivityX}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{Binding SensitivityYLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding SensitivityYText}" />
                </Grid>
                <Slider Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SensitivityY}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{Binding SmoothingLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding SmoothingText}" />
                </Grid>
                <Slider Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Smoothing}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{Binding DeadzoneLabel}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding DeadzoneText}" />
                </Grid>
                <Slider Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Deadzone}" />
              </StackPanel>
              <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{Binding InvertXLabel}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertX}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="4" Grid.Column="2" ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{Binding InvertYLabel}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertY}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" Width="170" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{Binding OffsetLabel}" HorizontalAlignment="Center" />
            <c:StickPreview Width="140" Height="140" HorizontalAlignment="Center" Accent="{StaticResource AccentBrush}"
                            RawX="{Binding OffsetX}" RawY="{Binding OffsetY}" TunedX="{Binding OffsetX}" TunedY="{Binding OffsetY}" IsLive="{Binding IsLive}" />
            <TextBlock Classes="caption" Text="{Binding OffsetHint}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,14,*">
      <!-- Stick swap and inversion -->
      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding SticksLabel}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding SwapLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwapSticks}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding InvertLeftXLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertLeftX}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding InvertLeftYLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertLeftY}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding InvertRightXLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertRightX}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding InvertRightYLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertRightY}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Gyro calibration -->
      <Border Grid.Column="2" Classes="panel">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock Classes="h2" Text="{Binding CalibrationLabel}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Theme="{StaticResource QuietButton}" Content="{Binding CalibrateText}" Command="{Binding CalibrateCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="body" Text="{Binding CalibrationHint}" />
          <StackPanel Spacing="8" Margin="0,6,0,0" IsVisible="{Binding HasCalibrationText}">
            <ProgressBar Classes="meter" Value="{Binding CalibrationProgress}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="label" Text="{Binding CalibrationText}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
