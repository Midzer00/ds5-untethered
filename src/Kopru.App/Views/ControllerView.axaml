<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:v="using:Kopru.App.Views"
             x:Class="Kopru.App.Views.ControllerView" x:DataType="vm:ControllerPageViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Spacing="{StaticResource GapLarge}" Classes="page">
      <!-- Header: title, description and the controller picker left; the Test tab's reset right -->
      <Grid Classes="pageHeader" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding Intro}" />
          <v:ControllerSelector DataContext="{Binding Test.Picker}" Margin="0,6,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Content="{Binding Tuning.ResetText}" Command="{Binding Tuning.ResetCommand}"
                IsVisible="{Binding IsTestTab}" />
      </Grid>

      <!-- Test first (what the controller sends, fixed right beside it), then the output tests, then remap & gyro -->
      <ListBox Theme="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" HorizontalAlignment="Left" MinWidth="420">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TabOption">
            <!-- Regular, and semibold while selected: two labels with a fixed weight each, so the selected one is always measured
                 bold (a label that only inherits the bold weight can keep its narrower size and lose its last letter) -->
            <Panel>
              <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="Normal" TextWrapping="NoWrap"
                         IsVisible="{Binding !$parent[ListBoxItem].IsSelected}" />
              <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="SemiBold" TextWrapping="NoWrap"
                         IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Panel IsVisible="{Binding IsTestTab}">
        <v:TesterView DataContext="{Binding Test}" />
      </Panel>

      <Panel IsVisible="{Binding IsOutputsTab}">
        <v:OutputTestsView DataContext="{Binding Test}" />
      </Panel>

      <Panel IsVisible="{Binding IsRemapTab}">
        <v:RemapView DataContext="{Binding Tuning.Remap}" />
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
