<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:v="using:Kopru.App.Views"
             x:Class="Kopru.App.Views.ControllerView" x:DataType="vm:ControllerPageViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Spacing="16" MaxWidth="1500" Margin="{StaticResource PagePadding}">
      <Grid ColumnDefinitions="*,16,Auto">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding Intro}" />
          <v:ControllerSelector DataContext="{Binding Test.Picker}" Margin="0,6,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Theme="{StaticResource QuietButton}" Content="{Binding Tuning.ResetText}" Command="{Binding Tuning.ResetCommand}" VerticalAlignment="Center"
                IsVisible="{Binding IsTestTab}" />
      </Grid>

      <!-- Test first (what the controller sends, fixed right beside it, and the output tests), then remap & gyro -->
      <ListBox Theme="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" HorizontalAlignment="Left" MinWidth="360">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TabOption">
            <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" TextWrapping="NoWrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Panel IsVisible="{Binding IsTestTab}">
        <v:TesterView DataContext="{Binding Test}" />
      </Panel>

      <Panel IsVisible="{Binding IsRemapTab}">
        <v:RemapView DataContext="{Binding Tuning.Remap}" />
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
