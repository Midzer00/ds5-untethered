<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:v="using:Kopru.App.Views" xmlns:c="using:Kopru.App.Controls" xmlns:gm="using:Kopru.Core.Games" x:Class="Kopru.App.Views.SupportedGamesView" x:DataType="vm:SupportedGamesViewModel">
  <UserControl.Styles>
    <!-- The game's settings pop-up: a dimmed backdrop over the page and one opaque, rounded dialog card filling it -->
    <Style Selector="Border.dialogBackdrop">
      <Setter Property="Background" Value="#99000000" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{StaticResource ToastBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="26,20,14,20" />
      <!-- As big as the page with a margin around it (on very wide screens no wider than this, centred) -->
      <Setter Property="MaxWidth" Value="1240" />
      <Setter Property="Margin" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- The list update's outcome when it failed -->
    <Style Selector="TextBlock.caption.error">
      <Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- A segmented choice's option: regular, and semibold while selected (two labels with a fixed weight each, so the
         selected one is always measured bold) -->
    <DataTemplate x:Key="FilterItem" x:DataType="vm:FilterOption">
      <Panel>
        <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="Normal" TextWrapping="NoWrap"
                   IsVisible="{Binding !$parent[ListBoxItem].IsSelected}" />
        <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="SemiBold" TextWrapping="NoWrap"
                   IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
      </Panel>
    </DataTemplate>
    <!-- This page's sizes (on the shared spacing scale) -->
    <Thickness x:Key="BlockGap">0,0,0,16</Thickness>
    <!-- The list card leaves the scroll bar room at the right: the children keep the card's 20 px with ListInset -->
    <Thickness x:Key="ListCardPadding">20,16,8,10</Thickness>
    <Thickness x:Key="ListInset">0,0,12,0</Thickness>
  </UserControl.Resources>
  <!-- Fills the window: the game list takes the free height and scrolls itself -->
  <Panel>
  <Grid RowDefinitions="Auto,Auto,*" Classes="page wide">
    <!-- Header: title and intro left, the game in the foreground right -->
    <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" Margin="{StaticResource BlockGap}">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <TextBlock Classes="body" Text="{Binding Intro}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="stateText" Classes.on="{Binding IsActive}" MaxWidth="340" ToolTip.Tip="{Binding CurrentGameText}"
                 Text="{Binding CurrentGameText}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- Steam Input: a warning when it may take the controller, a muted note when it could not be read -->
    <StackPanel Grid.Row="1">
      <Border Classes="panel" Padding="16,12" Margin="{StaticResource BlockGap}" IsVisible="{Binding HasSteamWarning}">
        <StackPanel Spacing="2">
          <TextBlock Classes="label" FontWeight="SemiBold" Foreground="{StaticResource IndicatorWaitBrush}" Text="{Binding SteamTitle}" />
          <TextBlock Classes="body" Text="{Binding SteamText}" />
        </StackPanel>
      </Border>
      <TextBlock Classes="caption" Margin="{StaticResource BlockGap}" Text="{Binding SteamText}" IsVisible="{Binding HasSteamNote}" />
    </StackPanel>

    <!-- The games: Supported (all, or only those installed here) or Unsupported (found or added, not in the list), search, the
         default controller type, one row per game, then the list's online update and pictures. Fills the height: the list
         scrolls inside -->
    <Border Grid.Row="2" Name="ListCard" Classes="panel fill" Padding="{StaticResource ListCardPadding}">
      <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <!-- Supported | Unsupported (n), the count shown, Add Game -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Gap}" Margin="{StaticResource ListInset}">
            <Border Classes="iconTile"><c:IconSlot Classes="accent" Data="{x:Static c:IconPaths.Gamepad}" HorizontalAlignment="Center" /></Border>
            <ListBox Grid.Column="1" Theme="{StaticResource Segmented}" Name="GameViewChoice" ItemsSource="{Binding ViewFilters}" SelectedIndex="{Binding ViewIndex}"
                     ItemTemplate="{StaticResource FilterItem}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ListLabel}" />
            <TextBlock Grid.Column="3" Name="ListCount" Classes="value" Text="{Binding CountText}" VerticalAlignment="Center" />
            <!-- Add a game: one of the running apps, or an exe file -->
            <Button Grid.Column="4" Name="AddGameButton" Theme="{StaticResource QuietButton}" Height="32" Padding="12,0" Content="{Binding AddGameText}" VerticalAlignment="Center">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="280" Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding RunningHeader}" Margin="4,0,0,2" />
                    <TextBlock Classes="body" Text="{Binding NoRunningText}" IsVisible="{Binding HasNoRunningApps}" Margin="4,0,0,4" />
                    <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding RunningApps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RunningAppItem">
                            <Button Theme="{StaticResource QuietButton}" Height="32" Padding="10,0" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).AddRunningCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Tip}">
                              <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Border Classes="divider" />
                    <Button Theme="{StaticResource QuietButton}" Height="32" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding AddFromFileCommand}" Content="{Binding AddFromFileText}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <!-- All | Installed (the count in the label; Supported only), then Scan Again and the extra folders searched for games -->
          <Grid Grid.Row="1" Name="InstalledRow" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,12,12,0" IsVisible="{Binding HasInstalledList}">
            <ListBox Theme="{StaticResource Segmented}" Name="InstalledChoice" ItemsSource="{Binding InstalledFilters}" SelectedIndex="{Binding InstalledFilterIndex}"
                     ItemTemplate="{StaticResource FilterItem}" MinWidth="190" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstalledFilterLabel}"
                     IsVisible="{Binding ShowsInstalledChoice}" />
            <Button Grid.Column="2" Name="ScanAgainButton" Theme="{StaticResource QuietButton}" Height="32" Padding="12,0" Command="{Binding ScanAgainCommand}"
                    Content="{Binding ScanText}" IsEnabled="{Binding !IsScanning}" VerticalAlignment="Center" />
            <!-- The extra folders: what is searched by itself, the added folders (each removable) and Add Folder -->
            <Button Grid.Column="3" Name="FoldersButton" Theme="{StaticResource QuietButton}" Height="32" Padding="12,0" Content="{Binding FoldersText}" VerticalAlignment="Center">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="300" Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding FoldersHint}" TextWrapping="Wrap" Margin="4,0,4,2" />
                    <TextBlock Classes="body" Text="{Binding NoFoldersText}" IsVisible="{Binding HasNoFolders}" Margin="4,0,0,4" />
                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GameFolderItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="4,0,0,4">
                              <TextBlock Classes="body" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      Command="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}"
                                      ToolTip.Tip="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).RemoveFolderText}"
                                      AutomationProperties.Name="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).RemoveFolderText}">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" StrokeLineCap="Round" Width="10" Height="10" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Border Classes="divider" />
                    <Button Theme="{StaticResource QuietButton}" Height="32" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding AddFolderCommand}" Content="{Binding AddFolderText}" />
                    <!-- Found games hidden from the list, each shown again with Show -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasHiddenGames}">
                      <Border Classes="divider" />
                      <TextBlock Classes="caption" Text="{Binding HiddenGamesHeader}" Margin="4,0,0,2" />
                      <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HiddenGames}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gm:HiddenGame">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="4,0,0,4">
                                <TextBlock Classes="body" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Height="28" Padding="10,0" VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).ShowHiddenCommand}" CommandParameter="{Binding}"
                                        Content="{Binding $parent[ItemsControl].((vm:SupportedGamesViewModel)DataContext).ShowGameText}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <TextBox Grid.Row="2" Margin="0,12,12,10" Text="{Binding SearchText}" Watermark="{Binding SearchWatermark}" />
          <v:GameRowList Grid.Row="3" Items="{Binding Games}" OpenCommand="{Binding OpenGameCommand}" PadChoice="{Binding Settings.PadType}" Pending="{Binding Settings}" PendingLine="{Binding PendingGameLine}">
            <v:GameRowList.Messages>
              <StackPanel>
                <TextBlock Classes="body" Text="{Binding NoMatchText}" IsVisible="{Binding HasNoMatch}" Margin="0,8,12,8" />
                <!-- "Installed" or "Unsupported" with nothing found: one sentence and Add Folder; while the first scan runs, that it is looking -->
                <StackPanel Name="InstalledEmpty" Spacing="10" Margin="0,8,12,8" IsVisible="{Binding HasNoInstalled}">
                  <TextBlock Classes="body" Text="{Binding InstalledEmptyText}" TextWrapping="Wrap" />
                  <Button Name="EmptyAddFolderButton" Theme="{StaticResource QuietButton}" Height="32" Padding="12,0" HorizontalAlignment="Left"
                          Command="{Binding AddFolderCommand}" Content="{Binding AddFolderText}" />
                </StackPanel>
                <TextBlock Classes="body" Text="{Binding InstalledSearchingText}" IsVisible="{Binding IsSearchingInstalled}" Margin="0,8,12,8" />
              </StackPanel>
            </v:GameRowList.Messages>
            <!-- "Installed" and "Unsupported": a game that was not found is added with Add Game (on "Unsupported" after what these
                 games get) -->
            <v:GameRowList.Footer>
              <TextBlock Name="InstalledAddHint" Classes="caption" Text="{Binding AddHintLine}" IsVisible="{Binding ShowsAddHint}"
                         TextWrapping="Wrap" Margin="0,6,12,0" />
            </v:GameRowList.Footer>
          </v:GameRowList>
          <!-- The list's online update (size and date or the outcome, weekly check, the button busy while checking) and the
               game pictures from Steam's CDN (off: only the pictures already on this PC) -->
          <Grid Grid.Row="4" Name="ListOptions" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}" Margin="0,6,12,0">
            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="2" VerticalAlignment="Center">
              <TextBlock Classes="caption" Text="{Binding ListStatusText}" IsVisible="{Binding CanUpdateList}" Classes.error="{Binding HasListError}"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <CheckBox IsChecked="{Binding Settings.AutoUpdateGameList}" IsVisible="{Binding CanUpdateList}" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding AutoUpdateLabel}" TextWrapping="NoWrap" />
              </CheckBox>
              <CheckBox Name="DownloadImagesBox" IsChecked="{Binding Settings.DownloadGameImages}" ToolTip.Tip="{Binding DownloadImagesHint}" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding DownloadImagesLabel}" TextWrapping="NoWrap" />
              </CheckBox>
            </WrapPanel>
            <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Height="28" Padding="12,0" Command="{Binding UpdateListCommand}"
                    Content="{Binding UpdateListText}" IsVisible="{Binding CanUpdateList}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Panel>
    </Border>
  </Grid>
  <!-- The clicked game's settings as a pop-up over the page: Esc, Close or a click on the backdrop closes it -->
  <Panel Name="GameDialogLayer" IsVisible="{Binding Panel.IsOpen}">
    <Border Name="GameDialogBackdrop" Classes="dialogBackdrop" />
    <Border Name="GameDialog" Classes="dialog">
      <v:GamePanelView Name="GamePanel" DataContext="{Binding Panel}" />
    </Border>
  </Panel>
  </Panel>
</UserControl>
