<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:v="using:Kopru.App.Views" x:Class="Kopru.App.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <!-- Setting row: title and description on the left, the control on the right -->
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,14" />
    </Style>
    <Style Selector="Grid.kind">
      <Setter Property="Margin" Value="0,10" />
    </Style>
    <Style Selector="Grid.kind > StackPanel">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The switch template keeps empty space right of the knob; pull it onto the same right edge as values and buttons -->
    <Style Selector="ToggleSwitch">
      <Setter Property="Margin" Value="0,0,-16,0" />
    </Style>
    <Style Selector=":disabled TextBlock">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Grid.row > StackPanel">
      <Setter Property="Spacing" Value="3" />
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer Classes="page">
    <StackPanel Spacing="0" MaxWidth="1500" Margin="32,28,32,28">
      <TextBlock Classes="h1" Text="{Binding Title}" Margin="0,0,0,20" />

      <v:ProfilesPanel DataContext="{Binding Settings.ProfilesPanel}" Margin="0,0,0,24" />

      <TextBlock Classes="section" Text="{Binding GeneralLabel}" Margin="0,0,0,8" />
      <Border Classes="panel" Padding="20,0">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding LanguageLabel}" />
              <TextBlock Classes="body" Text="{Binding LanguageHint}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="272" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding StartWithWindowsLabel}" />
              <TextBlock Classes="body" Text="{Binding StartWithWindowsHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.StartWithWindows}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding AutoStartBridgeLabel}" />
              <TextBlock Classes="body" Text="{Binding AutoStartBridgeHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoStartBridge}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding AutoStartBridgeLabel}" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding KeepInTrayLabel}" />
              <TextBlock Classes="body" Text="{Binding KeepInTrayHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.KeepInTray}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding IdlePowerOffLabel}" />
              <TextBlock Classes="body" Text="{Binding IdlePowerOffHint}" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="200,Auto" VerticalAlignment="Center">
              <Slider Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.IdlePowerOffMinutes}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="value" Margin="12,0,0,0" MinWidth="60" Text="{Binding Settings.IdlePowerOffText}" />
            </Grid>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding PowerOffWhenIdleLabel}" />
              <TextBlock Classes="body" Text="{Binding PowerOffWhenIdleHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PowerOffWhenIdle}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding AutoLowPowerLabel}" />
              <TextBlock Classes="body" Text="{Binding AutoLowPowerHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoLowPower}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding AutoLowPowerLabel}" />
          </Grid>
        </StackPanel>
      </Border>

      <v:ControllersPanel DataContext="{Binding Settings.ControllersPanel}" />

      <TextBlock Classes="section" Text="{Binding SpeakerGroupLabel}" Margin="0,24,0,8" />
      <Border Classes="panel" Padding="20,0" Name="SpeakerPanel">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding SpeakerSendLabel}" />
              <TextBlock Classes="body" Text="{Binding SpeakerSendHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SpeakerActive}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.SpeakerActive}">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding SpeakerVolumeLabel}" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="200,Auto" VerticalAlignment="Center">
              <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.SpeakerVolume}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="value" Margin="12,0,0,0" MinWidth="60" Text="{Binding Settings.SpeakerVolumeText}" />
            </Grid>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.SpeakerActive}">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding HeadphoneVolumeLabel}" />
              <TextBlock Classes="caption" Text="{Binding HeadphonesPluggedText}" IsVisible="{Binding HeadphonesPlugged}" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="200,Auto" VerticalAlignment="Center">
              <Slider Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.HeadphoneVolume}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="value" Margin="12,0,0,0" MinWidth="60" Text="{Binding Settings.HeadphoneVolumeText}" />
            </Grid>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="{Binding MicGroupLabel}" Margin="0,24,0,8" />
      <Border Classes="panel" Padding="20,0" Name="MicPanel">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding MicSendLabel}" />
              <TextBlock Classes="body" Text="{Binding MicSendHint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Name="MicSwitch" IsChecked="{Binding Settings.MicEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.MicEnabled}">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding MicGainLabel}" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="200,Auto" VerticalAlignment="Center">
              <Slider Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.MicGain}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="value" Margin="12,0,0,0" MinWidth="60" Text="{Binding Settings.MicGainText}" />
            </Grid>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.MicEnabled}">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding MicNoiseGateLabel}" />
              <TextBlock Classes="body" Text="{Binding MicNoiseGateHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.MicNoiseGate}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding MicMuteWindowsLabel}" />
              <TextBlock Classes="body" Text="{Binding MicMuteWindowsHint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.MicMuteWindows}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel IsVisible="{Binding MicActive}">
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding MicLevelLabel}" />
              </StackPanel>
              <ProgressBar Grid.Column="1" Name="MicMeter" Width="272" Minimum="0" Maximum="100" Value="{Binding MicLevel}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <v:ShortcutsPanel DataContext="{Binding Settings.ShortcutsPanel}" />

      <v:DesktopModePanel DataContext="{Binding Settings.DesktopPanel}" />

      <TextBlock Classes="section" Text="{Binding NotificationsLabel}" Margin="0,24,0,8" />
      <Border Classes="panel" Padding="20,0" Name="NotificationsPanel">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding NotificationsShowLabel}" />
              <TextBlock Classes="body" Text="{Binding NotificationsShowHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotificationsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.NotificationsEnabled}">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding QuietWhilePlayingLabel}" />
              <TextBlock Classes="body" Text="{Binding QuietWhilePlayingHint}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.QuietWhilePlaying}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <!-- One switch per kind, two columns -->
          <Grid ColumnDefinitions="*,40,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,10" IsEnabled="{Binding Settings.NotificationsEnabled}">
            <Grid Grid.Row="0" Grid.Column="0" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyConnectionLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyConnectionHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyConnection}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyBatteryLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyBatteryHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyBattery}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyGameLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyGameHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyGame}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifySteamInputLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifySteamInputHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifySteamInput}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyPowerOffLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyPowerOffHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyPowerOff}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="2" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyErrorsLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyErrorsHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyErrors}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0" Classes="kind" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding NotifyHidHideLabel}" />
                <TextBlock Classes="caption" Text="{Binding NotifyHidHideHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.NotifyHidHide}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="{Binding ToolsLabel}" Margin="0,24,0,8" />
      <Border Classes="panel" Padding="20,0">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding RunWizardText}" />
              <TextBlock Classes="body" Text="{Binding RunWizardHint}" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Content="{Binding RunActionText}" Command="{Binding RunWizardCommand}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding TestAdapterText}" />
              <TextBlock Classes="body" Text="{Binding TestAdapterHint}" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Content="{Binding TestActionText}" Command="{Binding TestAdapterCommand}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding ExportText}" />
              <TextBlock Classes="body" Text="{Binding ExportHint}" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Content="{Binding ExportActionText}" Command="{Binding ExportCommand}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Margin="0,16,0,0" IsVisible="{Binding HasToolResult}">
        <TextBlock Classes="body" Text="{Binding ToolResult}" />
      </Border>

      <!-- About: the logo with the name, version and what the app does -->
      <TextBlock Classes="section" Text="{Binding AboutLabel}" Margin="0,24,0,8" />
      <Border Classes="panel" Padding="20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
          <Image Source="/Assets/logo.png" Height="84" RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding AppName}" />
            <TextBlock Classes="caption" Text="{Binding VersionText}" />
            <TextBlock Classes="caption" Text="{Binding Info.Compact}" />
            <TextBlock Classes="body" Text="{Binding AboutTagline}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
