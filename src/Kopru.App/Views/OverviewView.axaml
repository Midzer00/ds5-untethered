<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:c="using:Kopru.App.Controls" xmlns:v="using:Kopru.App.Views" x:Class="Kopru.App.Views.OverviewView" x:DataType="vm:OverviewViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rowValue.poor"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>
    <Style Selector="TextBlock.rowValue.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <!-- Level bars in the live card: the shared horizontal meter (fixed height, full column width), flat colours:
         triggers in the accent, haptics a lighter blue -->
    <Style Selector="ProgressBar.meter.level">
      <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ProgressBar.meter.level.haptic">
      <Setter Property="Foreground" Value="#7AB0FF" />
    </Style>
    <Style Selector="Grid.levels > StackPanel">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <!-- Big line in the hero: the game, the controller or "no controller" -->
    <Style Selector="TextBlock.hero">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Battery under the hero name: glyph and plain number, amber number when low; no background -->
    <Style Selector="StackPanel.heroBattery">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="StackPanel.heroBattery > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.heroBattery > TextBlock.low">
      <Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" />
    </Style>
    <!-- Click target over a health chip that has a fix -->
    <Style Selector="Button.chipHit">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chipHit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF" />
    </Style>
    <Style Selector="Button.chipHit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1CFFFFFF" />
    </Style>
    <!-- Health chip state words: amber when it needs a look, red when it blocks -->
    <Style Selector="TextBlock.chipState.attention"><Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="TextBlock.chipState.problem"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>

    <!-- Quick settings tiles: label over a muted state word (On / Off picked by the tile's own state) -->
    <Style Selector="ToggleButton StackPanel.tileText">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="ToggleButton TextBlock.tileLabel">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ToggleButton TextBlock.tileState">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ToggleButton:checked TextBlock.tileState">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked TextBlock.tileState.off"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ToggleButton:unchecked TextBlock.tileState.on"><Setter Property="IsVisible" Value="False" /></Style>
    <!-- Three rows of tiles share the card with the sound and stepped rows: lower than the tile's default -->
    <Style Selector="Grid.tiles ToggleButton">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <!-- The small quiet button on the shortcuts tile (opens the shortcuts list): nothing at rest, a faint fill on hover,
         sinks when pressed, accent edge on keyboard focus -->
    <Style Selector="Button.tileAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="Button.tileAction:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" /></Style>
    <Style Selector="Button.tileAction:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
    <Style Selector="Button.tileAction:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
    <Style Selector="Button.tileAction:pointerover c|IconSlot"><Setter Property="Stroke" Value="{StaticResource TextBrush}" /></Style>
    <!-- Tooltips of the card: the same short delay everywhere, also over a row Low Power dims -->
    <Style Selector="ToggleButton, Grid.quickRow">
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="280" />
      <Setter Property="Background" Value="{StaticResource ToastBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="ToolTip TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Quick settings rows: the compact form of the shared setting row (seven rows and the tiles share one card that must
         fit the smallest window): icon and label left, control right; every control has the same width and ends on the
         card's right edge. The shared ControlWidth (240) leaves the labels no room at 1100 px, so the card uses its own. -->
    <Style Selector="Grid.quickRow">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="ColumnSpacing" Value="{StaticResource Gap}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.quickRow:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Grid.quickRow > TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.quickRow ListBox, Grid.quickRow ComboBox">
      <Setter Property="Width" Value="196" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.quickRow ComboBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Grid.quickRow ListBox">
      <Setter Property="Height" Value="30" />
    </Style>
    <!-- The two sound device pickers side by side, each under its tile: as tall as the row controls, the full column wide;
         the opened list is wider than the closed picker so whole device names show -->
    <Style Selector="Grid.quickPickers > ComboBox.quickDevice">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <!-- The closed picker leads with its icon (speaker / microphone), in the column of the tile icon above it -->
    <Style Selector="Grid.deviceBox">
      <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.deviceBox > c|IconSlot">
      <Setter Property="Margin" Value="3,0,0,0" />
    </Style>
    <Style Selector="ComboBox.quickDevice ComboBoxItem">
      <Setter Property="MinWidth" Value="260" />
    </Style>
    <!-- The cards of this page: a little less vertical padding than the shared card, so the quick settings' rows get the room -->
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style Selector="Grid.quickRow > TextBlock.caption">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <!-- Quiet text link (to the Settings page) -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- One screen by state: header with a plain status line and the one action, the controller and the live link on the
       left, the quick settings on the right, and the health of everything the bridge needs right under the cards. Every
       row sizes to its content; when the window has height to spare (taller than the design's shape) the page takes up
       to MaxExtra of it (ElasticHeight) and the cards' row (the star row) gets it: the quick settings' gaps and the live
       graph spread it, up to their caps, and the rest stays under the page. A window too short for the page is never
       squeezed: the page keeps its natural height and its bottom is cut off, as with plain Auto rows. -->
  <Border>
    <c:ElasticHeight MaxExtra="80" VerticalAlignment="Top">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Gap}" Classes="page wide">

      <!-- Header: title with the status line under it, turn off (with a controller) and, only while the virtual controller
           is off, its start or the blocking issue's fix (stopping lives in Settings and the tray menu) -->
      <Grid Classes="pageHeader" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="display" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding StatusLine}" ToolTip.Tip="{Binding Warning}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding PowerOffResult}" IsVisible="{Binding HasPowerOffResult}" />
          <v:ControllerSelector DataContext="{Binding Picker}" Margin="0,6,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Theme="{StaticResource QuietButton}" Height="40" Padding="14,0" Command="{Binding PowerOffCommand}" IsEnabled="{Binding CanPowerOff}"
                IsVisible="{Binding IsConnected}" ToolTip.Tip="{Binding PowerOffText}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
            <c:IconSlot Classes="accent" Data="{x:Static c:IconPaths.Power}" />
            <TextBlock Text="{Binding PowerOffText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Theme="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowsPrimary}"
                Content="{Binding PrimaryText}" MinWidth="170" IsEnabled="{Binding CanPrimary}" Name="PrimaryAction"
                ToolTip.Tip="{Binding PrimaryTip}" ToolTip.ShowOnDisabled="True" />
      </Grid>

      <!-- The two columns end on one line: the row is as tall as the taller column, and the live card (left) and the quick
           settings (right) stretch to it; neither grows with the window -->
      <Grid Grid.Row="1" ColumnDefinitions="10*,11*" ColumnSpacing="{StaticResource GapLarge}">
        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource GapLarge}">
          <!-- Hero: the controller drawing (light in the chosen colour, buttons lit while pressed) and what it is doing -->
          <Border Classes="panel">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="{StaticResource GapLarge}">
              <Viewbox Stretch="Uniform" MaxHeight="150" VerticalAlignment="Center">
                <Panel Width="204" Height="136" Opacity="{Binding ArtOpacity}">
                  <c:ControllerArt IsEdge="{Binding IsEdge}" LightColor="{Binding Settings.LightColor}" LightIntensity="{Binding ArtLightIntensity}"
                                   PlayerLeds="{Binding ArtPlayerLeds}" />
                  <c:ControllerInputOverlay Pressed="{Binding LivePressed}" IsEdge="{Binding IsEdge}" Accent="{StaticResource AccentBrush}" />
                </Panel>
              </Viewbox>

              <StackPanel Grid.Column="1" Spacing="{StaticResource Gap}" VerticalAlignment="Center">
                <!-- A game runs: its name first, then its mode -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowsGame}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding GameCaption}" />
                    <TextBlock Classes="hero" Text="{Binding GameValue}" ToolTip.Tip="{Binding GameDetail}" />
                    <StackPanel Classes="heroBattery" IsVisible="{Binding ShowsBattery}" ToolTip.Tip="{Binding BatteryTip}">
                      <c:BatteryGlyph Level="{Binding BatteryPercent}" IsCharging="{Binding IsCharging}" IsKnown="{Binding HasBattery}" Width="20" Height="10" VerticalAlignment="Center" />
                      <TextBlock Classes.low="{Binding IsBatteryLow}" Text="{Binding BatteryText}" />
                    </StackPanel>
                  </StackPanel>
                  <!-- The DualSense Mode switch lives in the quick settings tiles (and the sidebar); here only what it gives -->
                  <TextBlock Classes="caption" Text="{Binding SupportedModeHelper}" IsVisible="{Binding IsSupportedModeOn}" ToolTip.Tip="{Binding SupportedModeTip}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding ModeValue}" IsVisible="{Binding !IsSupportedModeOn}" ToolTip.Tip="{Binding SupportedModeTip}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Connected: the controller -->
                <StackPanel Spacing="2" IsVisible="{Binding ShowsDevice}">
                  <TextBlock Classes="caption" Text="{Binding DeviceCaption}" />
                  <TextBlock Classes="hero" Text="{Binding Picker.SelectedName}" ToolTip.Tip="{Binding Picker.SelectedName}" />
                  <StackPanel Classes="heroBattery" IsVisible="{Binding ShowsBattery}" ToolTip.Tip="{Binding BatteryTip}">
                      <c:BatteryGlyph Level="{Binding BatteryPercent}" IsCharging="{Binding IsCharging}" IsKnown="{Binding HasBattery}" Width="20" Height="10" VerticalAlignment="Center" />
                      <TextBlock Classes.low="{Binding IsBatteryLow}" Text="{Binding BatteryText}" />
                    </StackPanel>
                </StackPanel>
                <!-- No controller: why, and what to do -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowsNoController}">
                  <TextBlock Classes="hero" Text="{Binding NoControllerTitle}" TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock Classes="body" Text="{Binding NoControllerReason}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding LastBatteryText}" IsVisible="{Binding ShowsLastBatteryInHero}" />
                  <Button Theme="{StaticResource QuietButton}" Height="28" MinHeight="28" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" Margin="0,4,0,0"
                          Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" IsVisible="{Binding HasHeroAction}" />
                </StackPanel>
                <!-- Several controllers: the selected one can run its own profile instead of the global settings -->
                <StackPanel Spacing="6" IsVisible="{Binding Picker.IsMulti}">
                  <TextBlock Classes="caption" Text="{Binding Picker.ProfileLabel}" />
                  <ComboBox ItemsSource="{Binding Picker.ProfileOptions}" SelectedItem="{Binding Picker.SelectedProfile}" MinWidth="150" MaxWidth="240"
                            HorizontalAlignment="Left" AutomationProperties.Name="{Binding Picker.ProfileLabel}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Live: how the link feels (a coloured word, the numbers beside it) with the last 30 s as a graph on a fixed scale
               with the "you can feel it" line, one sentence on what to do, input rate with its low and average, L2 / haptics /
               R2 levels laid out like the controller (triggers on top, the two haptic motors under them). Stretched ("fill")
               only to end on the quick settings' line: the graph takes that bit of height, between its minimum and a cap. -->
          <Border Grid.Row="1" Classes="panel fill">
            <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource Gap}">
              <TextBlock Classes="h2" Text="{Binding LiveTitle}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Classes="body" Text="{Binding LiveIdle}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                         TextAlignment="Center" IsVisible="{Binding IsNotLive}" />
              <Grid Grid.Row="1" IsVisible="{Binding IsLive}" RowSpacing="{StaticResource Gap}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="72" MaxHeight="200" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The link as a word (coloured, no dot), the delay numbers beside it, then its last 30 seconds -->
                <Grid ColumnDefinitions="*,Auto,Auto" ToolTip.Tip="{Binding LatencyTip}" Background="Transparent">
                  <TextBlock Classes="rowLabel" Text="{Binding LinkLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding LatencyValue}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="2" Classes="rowValue" Classes.good="{Binding IsLinkGood}" Classes.warn="{Binding IsLinkBorderline}"
                             Classes.poor="{Binding IsLinkPoor}" Classes.muted="{Binding IsLinkMeasuring}" Text="{Binding LinkStateText}" TextWrapping="NoWrap" />
                </Grid>
                <Panel Grid.Row="1" ToolTip.Tip="{Binding Live.GraphTip}" Background="Transparent">
                  <c:Sparkline Values="{Binding Live.WorstHistory}" Secondary="{Binding Live.TypicalHistory}" Capacity="30" Maximum="{Binding Live.ScaleMaxMs}"
                               Limit="{Binding Live.LimitMs}" LimitLabel="{Binding Live.LimitLabel}" Unit="{Binding Live.Unit}"
                               Stroke="{StaticResource AccentBrush}" LimitBrush="{StaticResource DangerBrush}" LabelBrush="{StaticResource MutedBrush}" />
                  <TextBlock Classes="caption" Text="{Binding Live.GraphCaption}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Panel>
                <!-- What the state means for the player: one plain sentence -->
                <TextBlock Grid.Row="2" Classes="caption" Text="{Binding LinkAdvice}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <!-- Input rate now, with the low and the average of the same 30 seconds -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="rowLabel" Text="{Binding Live.RateLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Live.RateRange}" IsVisible="{Binding Live.HasRateRange}"
                             VerticalAlignment="Center" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding Live.RateValue}" TextWrapping="NoWrap" />
                </Grid>
                <!-- L2 and R2 on top, the left and right haptic motors under them: like the controller seen from the front.
                     Each level is a full-width bar under its name, so the four fill the card at any width. -->
                <Grid Grid.Row="4" Classes="levels" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource GapLarge}"
                      RowSpacing="{StaticResource Gap}" Margin="0,4,0,0">
                  <StackPanel ToolTip.Tip="{Binding Live.TriggersTip}">
                    <TextBlock Classes="caption" Text="{Binding Live.L2Label}" TextWrapping="NoWrap" />
                    <ProgressBar Classes="meter level" Value="{Binding Live.L2}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" ToolTip.Tip="{Binding Live.TriggersTip}">
                    <TextBlock Classes="caption" Text="{Binding Live.R2Label}" TextWrapping="NoWrap" />
                    <ProgressBar Classes="meter level" Value="{Binding Live.R2}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" ToolTip.Tip="{Binding Live.LeftHapticsTip}">
                    <TextBlock Classes="caption" Text="{Binding Live.LeftLabel}" TextWrapping="NoWrap" />
                    <ProgressBar Classes="meter level haptic" Value="{Binding Live.HapticsLeft}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" ToolTip.Tip="{Binding Live.RightHapticsTip}">
                    <TextBlock Classes="caption" Text="{Binding Live.RightLabel}" TextWrapping="NoWrap" />
                    <ProgressBar Classes="meter level haptic" Value="{Binding Live.HapticsRight}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- Quick settings: the same settings the detailed pages edit. On/off tiles first (two per row), the sound devices
             right under their tiles with the mic button's mode, then the controller's settings and the profile. One flat grid:
             the controls sit on their own rows and every gap is a row of its own (quickGap between rows, quickGroupGap between
             the groups), so a taller card (spare window height, see ElasticHeight) spreads
             over the gaps up to their caps instead of leaving one empty block. -->
        <Border Grid.Column="1" Classes="panel fill quickCard">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="0.75*" MinHeight="12" MaxHeight="16" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1.5*" MinHeight="16" MaxHeight="28" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1.5*" MinHeight="16" MaxHeight="28" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Title, with the link to the detailed settings on the right (always inside the card) -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="{Binding Quick.Title}" />
                <TextBlock Classes="caption" Text="{Binding Quick.DisconnectedNote}" IsVisible="{Binding Quick.ShowsDisconnectedNote}" />
                <!-- The sound pickers: one line why they can't be used here, or what Windows refused -->
                <TextBlock Classes="caption" Text="{Binding Quick.Audio.UnavailableShortText}" IsVisible="{Binding Quick.Audio.ShowsUnavailable}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Quick.Audio.UnavailableText}" />
                <TextBlock Classes="caption" Foreground="{StaticResource DangerBrush}" Text="{Binding Quick.Audio.ErrorText}" IsVisible="{Binding Quick.Audio.HasError}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1" Classes="link" VerticalAlignment="Top" Command="{Binding Quick.AdvancedCommand}">
                <TextBlock Text="{Binding Quick.AdvancedText}" />
              </Button>
            </Grid>

            <!-- On/off tiles: the whole tile is the switch; Speaker keeps the saved state while Low Power overrides it. The
                 Microphone tile is the mic button: a click is a press, the state word is the selected microphone's. -->
            <Grid Grid.Row="2" Classes="tiles" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
              <ToggleButton Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Leaf}" IsChecked="{Binding Quick.LowPowerOn}"
                            ToolTip.Tip="{Binding Quick.LowPowerTip}" AutomationProperties.Name="{Binding Quick.LowPowerLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.LowPowerLabel}" />
                  <TextBlock Classes="tileState" Text="{Binding Quick.LowPowerState}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Column="1" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Gamepad}" IsChecked="{Binding IsSupportedModeOn}"
                            ToolTip.Tip="{Binding Quick.SupportedModeTip}" AutomationProperties.Name="{Binding Quick.SupportedModeLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.SupportedModeLabel}" />
                  <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                  <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Row="1" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Mouse}" IsChecked="{Binding Quick.MouseModeOn}"
                            ToolTip.Tip="{Binding Quick.MouseModeTip}" AutomationProperties.Name="{Binding Quick.MouseModeLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.MouseModeLabel}" />
                  <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                  <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                </StackPanel>
              </ToggleButton>
              <!-- Controller Shortcuts; the small button on its right opens the shortcuts list without switching -->
              <Panel Grid.Row="1" Grid.Column="1">
                <ToggleButton Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Shortcut}" IsChecked="{Binding Quick.ShortcutsOn}"
                              ToolTip.Tip="{Binding Quick.ShortcutsTip}" AutomationProperties.Name="{Binding Quick.ShortcutsLabel}">
                  <StackPanel Classes="tileText" Margin="0,0,30,0">
                    <TextBlock Classes="tileLabel" Text="{Binding Quick.ShortcutsLabel}" />
                    <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                    <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                  </StackPanel>
                </ToggleButton>
                <Button Classes="tileAction" Theme="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding Quick.EditShortcutsCommand}"
                        ToolTip.Tip="{Binding Quick.EditShortcutsTip}" AutomationProperties.Name="{Binding Quick.EditShortcutsTip}">
                  <c:IconSlot Classes="small" Data="{x:Static c:IconPaths.ChevronRight}" />
                </Button>
              </Panel>
              <ToggleButton Grid.Row="2" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Speaker}" IsChecked="{Binding Quick.SpeakerOn}"
                            IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.SpeakerTip}" AutomationProperties.Name="{Binding Quick.SpeakerLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.SpeakerLabel}" />
                  <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                  <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Row="2" Grid.Column="1" Name="MicTile" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Microphone}" IsChecked="{Binding Quick.MicTile}"
                            IsEnabled="{Binding Quick.CanPressMic}" ToolTip.Tip="{Binding Quick.MicTip}" AutomationProperties.Name="{Binding Quick.MicLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.MicLabel}" />
                  <TextBlock Classes="tileState" Text="{Binding Quick.MicStateText}" />
                </StackPanel>
              </ToggleButton>
            </Grid>

            <!-- Sound: the Windows default output under the Speaker tile and the microphone under the Microphone tile (the same
                 two columns, the picker's icon under the tile's), then what the mic button does. A long device name is trimmed in the
                 closed picker (the tooltip has the full one); the opened list is at least quickDevice's popup width. -->
            <Grid Grid.Row="4" Classes="quickPickers" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource GapSmall}">
              <ComboBox Classes="quickDevice" Name="QuickOutputPicker" ItemsSource="{Binding Quick.Audio.Outputs}" SelectedItem="{Binding Quick.Audio.SelectedOutput}"
                        IsEnabled="{Binding Quick.Audio.CanChoose}" AutomationProperties.Name="{Binding Quick.Audio.OutputLabel}">
                <ToolTip.Tip>
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Quick.Audio.SelectedOutput.FullName}" IsVisible="{Binding Quick.Audio.SelectedOutput, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Quick.Audio.OutputTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <Grid Classes="deviceBox" ColumnDefinitions="Auto,*">
                      <c:IconSlot Data="{x:Static c:IconPaths.Speaker}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="1" Classes="quickDevice" Name="QuickInputPicker" ItemsSource="{Binding Quick.Audio.Inputs}" SelectedItem="{Binding Quick.Audio.SelectedInput}"
                        IsEnabled="{Binding Quick.Audio.CanChoose}" AutomationProperties.Name="{Binding Quick.Audio.InputLabel}">
                <ToolTip.Tip>
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Quick.Audio.SelectedInput.FullName}" IsVisible="{Binding Quick.Audio.SelectedInput, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Quick.Audio.InputTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <Grid Classes="deviceBox" ColumnDefinitions="Auto,*">
                      <c:IconSlot Data="{x:Static c:IconPaths.Microphone}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
            </Grid>
            <Grid Grid.Row="6" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.MicButtonTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.MicButton}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.MicButtonLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.MicButtonModes}" SelectedIndex="{Binding Quick.MicButtonModeIndex}"
                       AutomationProperties.Name="{Binding Quick.MicButtonLabel}" />
            </Grid>

            <!-- The controller type games see, the stepped settings and the profile: icon and label left, the control on the card's right edge -->
            <Grid Grid.Row="8" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.PadType.Tip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Gamepad}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.PadType.Label}" />
              <ComboBox Grid.Column="2" Name="QuickPadTypePicker" ItemsSource="{Binding Quick.PadType.Options}" SelectedItem="{Binding Quick.PadType.Selected}"
                        AutomationProperties.Name="{Binding Quick.PadType.Label}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadChoiceOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid Grid.Row="10" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.HapticsTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Haptics}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.HapticsLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.StrengthSteps}" SelectedIndex="{Binding Quick.HapticsIndex}"
                       AutomationProperties.Name="{Binding Quick.HapticsLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.HapticsCustom}" IsVisible="{Binding Quick.HasHapticsCustom}" />
            </Grid>
            <Grid Grid.Row="12" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.TriggerTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Trigger}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.TriggerLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.StrengthSteps}" SelectedIndex="{Binding Quick.TriggerIndex}"
                       AutomationProperties.Name="{Binding Quick.TriggerLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.TriggerCustom}" IsVisible="{Binding Quick.HasTriggerCustom}" />
            </Grid>
            <Grid Grid.Row="14" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.LightTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Light}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.LightLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.LightSteps}" SelectedIndex="{Binding Quick.LightIndex}"
                       AutomationProperties.Name="{Binding Quick.LightLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.LightCustom}" IsVisible="{Binding Quick.HasLightCustom}" />
            </Grid>
            <Grid Grid.Row="16" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.ProfileTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Profile}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding ProfileLabel}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="{Binding ProfileLabel}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Health: one quiet line while everything is fine; the items (with a fix where there is one) when something needs a look -->
      <TextBlock Grid.Row="2" Classes="caption" Text="{Binding HealthSummary}" IsVisible="{Binding IsHealthAllGood}" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
      <ItemsControl Grid.Row="2" ItemsSource="{Binding HealthChips}" IsVisible="{Binding ShowsHealthChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="{StaticResource GapSmall}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HealthChipViewModel">
            <!-- A panel; when there is a fix the whole chip is its button (a "›" shows it, the tooltip names it) -->
            <Panel>
              <Border Classes="panel" Padding="12,0" Height="50" ToolTip.Tip="{Binding Reason}">
                <!-- The name has the full width (long names like "Sanal Kumanda" fit); the fix sits next to the state -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Classes="caption chipState" Classes.attention="{Binding IsAttention}" Classes.problem="{Binding IsProblem}"
                             Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasAction}">
                    <TextBlock Text="{Binding ActionText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Path Data="M1,1 L5,5 L1,9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="6" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Button Classes="chipHit" Command="{Binding RunCommand}" IsVisible="{Binding HasAction}" ToolTip.Tip="{Binding ActionTip}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    </c:ElasticHeight>
  </Border>
</UserControl>
