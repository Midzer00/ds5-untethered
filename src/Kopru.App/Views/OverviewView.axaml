<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kopru.App.ViewModels" xmlns:c="using:Kopru.App.Controls" xmlns:v="using:Kopru.App.Views" x:Class="Kopru.App.Views.OverviewView" x:DataType="vm:OverviewViewModel">
  <!-- The live card's palette: flat colours the app already uses (accent blue, the Support pink, the wait amber) and a
       violet and a teal; the chart and gauge take the verdict colours. Fills are these at low opacity, never gradients. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="LiveBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="LivePinkBrush" Color="#DB61A2" />
    <SolidColorBrush x:Key="LiveVioletBrush" Color="#9B8AFB" />
    <SolidColorBrush x:Key="LiveTealBrush" Color="#3DBDAA" />
    <SolidColorBrush x:Key="LiveAmberBrush" Color="#C9A24A" />
    <SolidColorBrush x:Key="LiveLimitBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="LiveTrackBrush" Color="#26FFFFFF" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.rowValue.poor"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>
    <Style Selector="TextBlock.rowValue.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <!-- The live card: the delay headline -->
    <Style Selector="TextBlock.liveBig">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.linkWord.good"><Setter Property="Foreground" Value="{StaticResource IndicatorOnBrush}" /></Style>
    <Style Selector="TextBlock.linkWord.warn"><Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="TextBlock.linkWord.poor"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>
    <Style Selector="TextBlock.linkWord.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
    <!-- The quality gauge and the chart in the verdict's colour (accent while measuring) -->
    <Style Selector="c|QualityGauge.quality"><Setter Property="Fill" Value="{StaticResource MutedBrush}" /><Setter Property="Track" Value="{StaticResource LiveTrackBrush}" /></Style>
    <Style Selector="c|QualityGauge.quality.good"><Setter Property="Fill" Value="{StaticResource IndicatorOnBrush}" /></Style>
    <Style Selector="c|QualityGauge.quality.warn"><Setter Property="Fill" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="c|QualityGauge.quality.poor"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></Style>
    <Style Selector="c|Sparkline.zone"><Setter Property="Stroke" Value="{StaticResource AccentBrush}" /></Style>
    <Style Selector="c|Sparkline.zone.good"><Setter Property="Stroke" Value="{StaticResource IndicatorOnBrush}" /></Style>
    <Style Selector="c|Sparkline.zone.warn"><Setter Property="Stroke" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="c|Sparkline.zone.poor"><Setter Property="Stroke" Value="{StaticResource DangerBrush}" /></Style>
    <Style Selector="TextBlock.linkWord">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- "Kablolu" is no verdict: the secondary text colour -->
    <Style Selector="TextBlock.linkWord.wired"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /></Style>
    <!-- The chart's scale value in its band above the plot -->
    <Style Selector="TextBlock.axis">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- The link notice's icon: the verdict's colour -->
    <Style Selector="c|IconSlot.notice"><Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" /></Style>
    <Style Selector="c|IconSlot.notice.warn"><Setter Property="Stroke" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="c|IconSlot.notice.poor"><Setter Property="Stroke" Value="{StaticResource DangerBrush}" /></Style>
    <!-- The hero's state title without a controller -->
    <Style Selector="TextBlock.state">
      <Setter Property="FontSize" Value="{StaticResource FontH1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Signals lanes: the trace, then the names and current values in a narrow column on the right -->
    <Style Selector="Grid.lane">
      <Setter Property="ColumnSpacing" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="StackPanel.laneValues">
      <Setter Property="Width" Value="60" />
      <Setter Property="Spacing" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.laneValue">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="TextBlock.laneName, TextBlock.laneTitle, TextBlock.laneNumber">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.laneName">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="16" />
    </Style>
    <Style Selector="TextBlock.laneTitle"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.laneNumber">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="MinWidth" Value="18" />
    </Style>
    <!-- Big line in the hero: the game, the controller or "no controller" -->
    <Style Selector="TextBlock.hero">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Battery under the hero name: glyph and plain number, amber number when low; no background -->
    <Style Selector="StackPanel.heroBattery">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="StackPanel.heroBattery > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.heroBattery > TextBlock.low">
      <Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" />
    </Style>
    <!-- Click target over a health chip that has a fix -->
    <Style Selector="Button.chipHit">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chipHit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF" />
    </Style>
    <Style Selector="Button.chipHit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1CFFFFFF" />
    </Style>
    <!-- Health chip state words: amber when it needs a look, red when it blocks -->
    <Style Selector="TextBlock.chipState.attention"><Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="TextBlock.chipState.problem"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>

    <!-- Quick settings tiles: label over a muted state word (On / Off picked by the tile's own state) -->
    <Style Selector="ToggleButton StackPanel.tileText">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="ToggleButton TextBlock.tileLabel">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}" />
    </Style>
    <Style Selector="ToggleButton TextBlock.tileState">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ToggleButton:checked TextBlock.tileState">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked TextBlock.tileState.off"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ToggleButton:unchecked TextBlock.tileState.on"><Setter Property="IsVisible" Value="False" /></Style>
    <!-- Three rows of tiles share the card with the sound and stepped rows: lower than the tile's default -->
    <Style Selector="Grid.tiles ToggleButton">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <!-- The small quiet button on the shortcuts tile (opens the shortcuts list): nothing at rest, a faint fill on hover,
         sinks when pressed, accent edge on keyboard focus -->
    <Style Selector="Button.tileAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="Button.tileAction:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" /></Style>
    <Style Selector="Button.tileAction:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
    <Style Selector="Button.tileAction:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
    <Style Selector="Button.tileAction:pointerover c|IconSlot"><Setter Property="Stroke" Value="{StaticResource TextBrush}" /></Style>
    <!-- Tooltips of the card: the same short delay everywhere, also over a row Low Power dims -->
    <Style Selector="ToggleButton, Grid.quickRow">
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>

    <!-- Quick settings rows: the compact form of the shared setting row (seven rows and the tiles share one card that must
         fit the smallest window): icon and label left, control right; every control has the same width and ends on the
         card's right edge. The shared ControlWidth (240) leaves the labels no room at 1100 px, so the card uses its own. -->
    <Style Selector="Grid.quickRow">
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="ColumnSpacing" Value="{StaticResource Gap}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.quickRow:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Grid.quickRow > TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.quickRow ListBox, Grid.quickRow ComboBox">
      <Setter Property="Width" Value="196" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The two sound device pickers side by side, each under its tile: as tall as the row controls, the full column wide;
         the opened list is wider than the closed picker so whole device names show -->
    <Style Selector="Grid.quickPickers > ComboBox.quickDevice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <!-- The closed picker leads with its icon (speaker / microphone), in the column of the tile icon above it -->
    <Style Selector="Grid.deviceBox">
      <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.deviceBox > c|IconSlot">
      <Setter Property="Margin" Value="3,0,0,0" />
    </Style>
    <Style Selector="ComboBox.quickDevice ComboBoxItem">
      <Setter Property="MinWidth" Value="260" />
    </Style>
    <!-- The cards of this page: a little less vertical padding than the shared card, so the quick settings' rows get the room -->
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style Selector="Grid.quickRow > TextBlock.caption">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <!-- Quiet text link (to the Settings page) -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- One screen by state: header with a plain status line and the one action, the controller and the live link on the
       left, the quick settings on the right, and the health of everything the bridge needs right under the cards. Every
       row sizes to its content; when the window has height to spare (taller than the design's shape) the page takes up
       to MaxExtra of it (ElasticHeight) and the cards' row (the star row) gets it: the quick settings' gaps and the live
       graph spread it, up to their caps, and the rest stays under the page. A window too short for the page is never
       squeezed: the page keeps its natural height and its bottom is cut off, as with plain Auto rows. -->
  <Border>
    <c:ElasticHeight MaxExtra="80" VerticalAlignment="Top">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Gap}" Classes="page wide">

      <!-- Header: title with the status line under it, back to the game (while a known game runs; GameReturn), turn off
           (with a controller) and, only while the virtual controller is off, its start or the blocking issue's fix (stopping
           lives in Settings and the tray menu) -->
      <Grid Classes="pageHeader" ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding StatusLine}" ToolTip.Tip="{Binding Warning}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding PowerOffResult}" IsVisible="{Binding HasPowerOffResult}" />
          <v:ControllerSelector DataContext="{Binding Picker}" Margin="0,6,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Theme="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeightLarge}" Padding="14,0" Name="BackToGame"
                Command="{Binding BackToGame.BackCommand}" IsVisible="{Binding BackToGame.IsGameRunning}"
                ToolTip.Tip="{Binding BackToGame.ToolTip}" AutomationProperties.Name="{Binding BackToGame.Label}"
                AutomationProperties.HelpText="{Binding BackToGame.ToolTip}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
            <c:IconSlot Data="{x:Static c:IconPaths.Back}" Stroke="White" />
            <TextBlock Text="{Binding BackToGame.Label}" VerticalAlignment="Center" TextWrapping="NoWrap" />
          </StackPanel>
        </Button>
        <!-- Close Game (only while a game is detected as running) just left of Turn Off Controller, in its style. After the close
             request the button's place says the game is closing; when the game stayed open, it asks whether to end it: Force Close
             (the one red word) and Cancel -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GapLarge}">
          <Button Name="CloseGameButton" Theme="{StaticResource QuietButton}" Height="{StaticResource ControlHeightLarge}" Padding="14,0" Command="{Binding BackToGame.CloseGameCommand}"
                  IsVisible="{Binding BackToGame.ShowsCloseGame}" ToolTip.Tip="{Binding BackToGame.CloseGameTip}" AutomationProperties.Name="{Binding BackToGame.CloseGameText}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
              <c:IconSlot Classes="accent" Data="{x:Static c:IconPaths.Cross}" />
              <TextBlock Text="{Binding BackToGame.CloseGameText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
          <TextBlock Name="ClosingGameText" Classes="caption" Text="{Binding BackToGame.ClosingText}" IsVisible="{Binding BackToGame.IsClosing}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <Border Name="ForceCloseAsk" IsVisible="{Binding BackToGame.ConfirmsForceClose}" Background="{StaticResource QuietFillPressedBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="10" Height="{StaticResource ControlHeightLarge}" Padding="12,0,4,0" ToolTip.Tip="{Binding BackToGame.ForceCloseQuestion}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="{Binding BackToGame.ForceCloseAskText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Name="ForceCloseButton" Theme="{StaticResource QuietButton}" Height="30" Padding="10,0" CornerRadius="8"
                        Command="{Binding BackToGame.ForceCloseCommand}" Foreground="{StaticResource DangerBrush}" Content="{Binding BackToGame.ForceCloseText}" />
                <Button Name="KeepGameButton" Theme="{StaticResource QuietButton}" Height="30" Padding="10,0" CornerRadius="8"
                        Command="{Binding BackToGame.KeepGameCommand}" Content="{Binding BackToGame.CancelText}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- Turn Off Controller steps aside while Close Game asks its question (the title keeps its room) -->
          <Button Name="PowerOffButton" Theme="{StaticResource QuietButton}" Height="{StaticResource ControlHeightLarge}" Padding="14,0" Command="{Binding PowerOffCommand}" IsEnabled="{Binding CanPowerOff}"
                  IsVisible="{Binding ShowsPowerOff}" ToolTip.Tip="{Binding PowerOffText}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
              <c:IconSlot Classes="accent" Data="{x:Static c:IconPaths.Power}" />
              <TextBlock Text="{Binding PowerOffText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="3" Theme="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowsPrimary}"
                Content="{Binding PrimaryText}" MinWidth="170" IsEnabled="{Binding CanPrimary}" Name="PrimaryAction"
                ToolTip.Tip="{Binding PrimaryTip}" ToolTip.ShowOnDisabled="True" />
      </Grid>

      <!-- The two columns end on one line: the row is as tall as the taller column, and the live card (left) and the quick
           settings (right) stretch to it; neither grows with the window -->
      <Grid Grid.Row="1" ColumnDefinitions="10*,11*" ColumnSpacing="{StaticResource GapLarge}">
        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource GapLarge}">
          <!-- Hero: the controller drawing (light in the chosen colour, buttons lit while pressed) beside its name, battery and the
               type games see, and under both the connection line (the links' icons, the mode, "Deneysel" on the cable). The
               drawing is as large as the card allows beside the texts (ArtRow). Without a controller: the state, why, the last
               battery. -->
          <Border Classes="panel">
            <Grid RowDefinitions="*,Auto">
              <c:ArtRow>
                <Viewbox Name="HeroArt" Stretch="Uniform" MaxWidth="160" MaxHeight="104">
                  <Panel Width="204" Height="136" Opacity="{Binding ArtOpacity}">
                    <c:ControllerArt IsEdge="{Binding IsEdge}" Look="{Binding Settings.ActiveLook}" LightColor="{Binding Settings.Live.Color}" LightIntensity="{Binding Settings.Live.Intensity}"
                                     PlayerLedMask="{Binding Settings.Live.PlayerLedMask}" PlayerLedLevel="{Binding Settings.Live.PlayerLedLevel}" />
                    <c:ControllerInputOverlay Pressed="{Binding LivePressed}" IsEdge="{Binding IsEdge}" Look="{Binding Settings.ActiveLook}" Accent="{StaticResource AccentBrush}" />
                  </Panel>
                </Viewbox>

                <!-- Connected: the controller -->
                <StackPanel Name="HeroPadTexts" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="6" IsVisible="{Binding !ShowsNoController}">
                  <StackPanel Spacing="2">
                    <TextBlock Name="HeroName" Classes="hero" Text="{Binding Picker.SelectedName}" ToolTip.Tip="{Binding Picker.SelectedName}" />
                    <StackPanel Classes="heroBattery" Margin="0" IsVisible="{Binding ShowsBattery}" ToolTip.Tip="{Binding BatteryTip}">
                      <c:BatteryGlyph Level="{Binding BatteryPercent}" IsCharging="{Binding IsCharging}" IsKnown="{Binding HasBattery}" Width="20" Height="10" VerticalAlignment="Center" />
                      <TextBlock Classes.low="{Binding IsBatteryLow}" Text="{Binding BatteryText}" />
                    </StackPanel>
                  </StackPanel>
                  <!-- While the virtual controller runs: the type games see, what it lacks, and a type held back for the running game -->
                  <TextBlock Name="HeroPadStatus" Classes="body" Text="{Binding GameSeesText}" FontWeight="SemiBold" MaxWidth="144" HorizontalAlignment="Left"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Background="Transparent" ToolTip.Tip="{Binding PadTypeTip}"
                             IsVisible="{Binding ShowsPadStatus}" />
                  <TextBlock Classes="caption" Text="{Binding PadLossLine}" IsVisible="{Binding ShowsHeroPadLoss}" MaxWidth="144" HorizontalAlignment="Left" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                             Background="Transparent" ToolTip.Tip="{Binding PadTypeTip}" />
                  <StackPanel Spacing="4" MaxWidth="144" HorizontalAlignment="Left" IsVisible="{Binding ShowsHeroPendingPadType}">
                    <TextBlock Classes="caption" Foreground="{StaticResource TextBrush}" Text="{Binding PendingPadLine}" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" Background="Transparent" ToolTip.Tip="{Binding PendingPadTip}" />
                    <Button Name="HeroApplyPadType" Theme="{StaticResource QuietButton}" Height="{StaticResource ControlHeightSmall}" MinHeight="0" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left"
                            Content="{Binding ApplyPadTypeNowText}" Command="{Binding ApplyPadTypeNowCommand}" ToolTip.Tip="{Binding PendingPadTip}" />
                  </StackPanel>
                  <!-- Several controllers: the selected one can run its own profile instead of the global settings -->
                  <StackPanel Spacing="6" IsVisible="{Binding Picker.IsMulti}">
                    <TextBlock Classes="caption" Text="{Binding Picker.ProfileLabel}" />
                    <ComboBox ItemsSource="{Binding Picker.ProfileOptions}" SelectedItem="{Binding Picker.SelectedProfile}" MinWidth="144" MaxWidth="186"
                              HorizontalAlignment="Left" AutomationProperties.Name="{Binding Picker.ProfileLabel}" />
                  </StackPanel>
                </StackPanel>

                <!-- No controller: the state, why, the last battery and what to press -->
                <StackPanel Name="HeroStateTexts" Width="180" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="4" IsVisible="{Binding ShowsNoController}">
                  <TextBlock Classes="state" Text="{Binding NoControllerTitle}" />
                  <TextBlock Classes="body" Text="{Binding NoControllerReason}" LineHeight="18" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding LastBatteryText}" IsVisible="{Binding ShowsLastBatteryInHero}" TextWrapping="NoWrap" />
                  <Button Theme="{StaticResource QuietButton}" Height="{StaticResource ControlHeightSmall}" MinHeight="0" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" Margin="0,4,0,0"
                          Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" IsVisible="{Binding HasHeroAction}" />
                </StackPanel>
              </c:ArtRow>

              <c:LinkLine Grid.Row="1" Name="HeroLink" Hero="True" Height="20" Margin="0,6,0,0" IsVisible="{Binding ShowsHeroLink}"
                          Bluetooth="{Binding BluetoothUse}" Usb="{Binding UsbUse}" Text="{Binding HeroLinkText}" TagText="{Binding HeroLinkTag}" ShowsTag="{Binding ShowsHeroLinkTag}" />
            </Grid>
          </Border>

          <!-- Live, in two views picked in the header: Link (the typical delay as the headline, its caption naming the measured
               link, beside a small quality gauge in the verdict's colour with its word, or on the cable a quiet cable tile with
               "Kablolu"; the last 60 s as an area chart with its scale's top value in a band above it; what the chart covers and
               the input rate in one muted line) and Signals (the last 10 s of the triggers, the haptic motors and the live
               microphone as small scrolling traces). A fair or weak link puts a short notice on top. Both views share one cell,
               so the card keeps its height whichever is shown. Without live numbers: the chain controller -> virtual controller
               -> game, a title and one short paragraph. Stretched ("fill") only to end on the quick settings' line. -->
          <Border Grid.Row="1" Classes="panel fill" Name="LiveCard">
            <Panel>
              <Grid IsVisible="{Binding IsLive}" RowDefinitions="Auto,Auto,*">
                <!-- The notice: a quiet filled row, the verdict's colour on its icon only, the title leading the sentence in -->
                <Border Name="LinkNotice" Background="{StaticResource QuietFillBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,6" Margin="0,0,0,12"
                        IsVisible="{Binding ShowsLinkNotice}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <c:IconSlot Data="{x:Static c:IconPaths.Bluetooth}" Size="16" VerticalAlignment="Top" Classes="notice" Classes.warn="{Binding IsLinkBorderline}"
                                Classes.poor="{Binding IsLinkPoor}" />
                    <TextBlock Name="LinkAdvice" Grid.Column="1" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="16"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding LinkNoticeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                      <Run Text="{Binding LinkNoticeRest}" />
                    </TextBlock>
                  </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}">
                  <TextBlock Classes="h2" Text="{Binding LiveTitle}" VerticalAlignment="Center" />
                  <ListBox Grid.Column="1" Name="LiveViews" Theme="{StaticResource Segmented}" ItemsSource="{Binding Live.Views}" SelectedIndex="{Binding Live.SelectedView}"
                           MinWidth="176" AutomationProperties.Name="{Binding LiveTitle}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:TabOption">
                        <Panel>
                          <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="Normal" TextWrapping="NoWrap"
                                     IsVisible="{Binding !$parent[ListBoxItem].IsSelected}" />
                          <TextBlock Text="{Binding Name}" Foreground="{Binding $parent[ListBoxItem].Foreground}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                     IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <Panel Grid.Row="2">
                  <!-- Link: one flat grid, the gaps are rows of their own (12 px, down to 6 when the card is short), so a low card
                       keeps its chart readable; the chart takes the spare height -->
                  <Grid Name="LiveLink" IsVisible="{Binding Live.IsLinkView}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" MinHeight="6" MaxHeight="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="6" MaxHeight="12" />
                      <RowDefinition Height="6*" MinHeight="40" MaxHeight="260" />
                      <RowDefinition Height="*" MinHeight="6" MaxHeight="12" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" Name="LiveHeadline" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Gap}" ToolTip.Tip="{Binding LatencyTip}" Background="Transparent">
                      <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Classes="liveBig" Text="{Binding Live.DelayValue}" />
                        <TextBlock Name="DelayCaption" Classes="caption" Text="{Binding Live.DelayCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <!-- The gauge's slot (76 wide): the gauge with its word on Bluetooth; the cable in a quiet tile with "Kablolu" on USB -->
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="76">
                        <Panel Height="40">
                          <c:QualityGauge Name="LinkGauge" Width="76" Height="40" HorizontalAlignment="Center" Level="{Binding LinkLevel}" Classes="quality"
                                          Classes.good="{Binding IsLinkGood}" Classes.warn="{Binding IsLinkBorderline}" Classes.poor="{Binding IsLinkPoor}"
                                          IsVisible="{Binding !IsLinkWired}" />
                          <Border Name="WiredTile" Classes="iconTile" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsVisible="{Binding IsLinkWired}">
                            <c:IconSlot Data="{x:Static c:IconPaths.Cable}" Size="20" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                          </Border>
                        </Panel>
                        <TextBlock Name="LinkWord" Classes="linkWord" Classes.good="{Binding IsLinkGood}" Classes.warn="{Binding IsLinkBorderline}"
                                   Classes.poor="{Binding IsLinkPoor}" Classes.muted="{Binding IsLinkMeasuring}" Classes.wired="{Binding IsLinkWired}" Text="{Binding LinkStateText}" />
                      </StackPanel>
                    </Grid>
                    <!-- The chart with its scale's top value in a band of its own above the plot (never over the data or the limit line) -->
                    <Panel Grid.Row="3" ToolTip.Tip="{Binding Live.GraphTip}" Background="Transparent">
                      <c:Sparkline Name="LinkChart" Classes="zone" Classes.good="{Binding IsLinkGood}" Classes.warn="{Binding IsLinkBorderline}" Classes.poor="{Binding IsLinkPoor}"
                                   Margin="0,6,0,0" Values="{Binding Live.WorstHistory}" Secondary="{Binding Live.TypicalHistory}" Marks="{Binding Live.TroubleMarks}" Capacity="60"
                                   Maximum="{Binding Live.ChartTop}" Limit="{Binding Live.ShownLimitMs}" Unit="{Binding Live.Unit}"
                                   LimitBrush="{StaticResource LiveLimitBrush}" LabelBrush="Transparent" />
                      <TextBlock Name="ChartScale" Classes="axis" Text="{Binding Live.ChartTopText}" HorizontalAlignment="Right" />
                    </Panel>
                    <!-- One muted line: what the chart covers, and the input rate -->
                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Name="ChartNote" Classes="caption" Text="{Binding Live.GraphCaption}" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="1" Name="LiveRate" Classes="caption" Text="{Binding Live.RateValue}" IsVisible="{Binding Live.HasRate}" TextWrapping="NoWrap"
                                 ToolTip.Tip="{Binding Live.RateLabel}" />
                    </Grid>
                  </Grid>

                  <!-- Signals: one lane per group, its trace left and its names with the current values right; the lanes grow up to
                       a cap and the muted footer line stays on the card's bottom, as in the Link view -->
                  <Grid Name="LiveSignals" IsVisible="{Binding Live.IsSignalsView}" RowDefinitions="*,Auto" RowSpacing="10" Margin="0,12,0,0" Background="Transparent"
                        ToolTip.Tip="{Binding Live.SignalsTip}">
                    <Grid RowSpacing="10">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="34" MaxHeight="80" />
                        <RowDefinition Height="*" MinHeight="34" MaxHeight="80" />
                        <RowDefinition Height="*" MinHeight="34" MaxHeight="80" />
                      </Grid.RowDefinitions>
                      <Grid Classes="lane" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Live.TriggersTip}">
                        <c:SignalTrace Name="TriggerTrace" Mode="Areas" Primary="{Binding Live.L2Trace}" Secondary="{Binding Live.R2Trace}" Revision="{Binding Live.SignalRevision}"
                                       PrimaryBrush="{StaticResource LivePinkBrush}" SecondaryBrush="{StaticResource LiveBlueBrush}" />
                        <StackPanel Grid.Column="1" Classes="laneValues">
                          <StackPanel Classes="laneValue">
                            <TextBlock Classes="laneName" Foreground="{StaticResource LivePinkBrush}" Text="{Binding Live.L2Label}" />
                            <TextBlock Classes="laneNumber" Text="{Binding Live.L2Text}" />
                          </StackPanel>
                          <StackPanel Classes="laneValue">
                            <TextBlock Classes="laneName" Foreground="{StaticResource LiveBlueBrush}" Text="{Binding Live.R2Label}" />
                            <TextBlock Classes="laneNumber" Text="{Binding Live.R2Text}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <Grid Grid.Row="1" Classes="lane" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Live.HapticsTip}">
                        <c:SignalTrace Name="HapticsTrace" Mode="Mirrored" Primary="{Binding Live.HapticsLeftTrace}" Secondary="{Binding Live.HapticsRightTrace}"
                                       Revision="{Binding Live.SignalRevision}" PrimaryBrush="{StaticResource LiveVioletBrush}" SecondaryBrush="{StaticResource LiveTealBrush}" />
                        <StackPanel Grid.Column="1" Classes="laneValues">
                          <TextBlock Classes="laneTitle" Text="{Binding Live.HapticsLabel}" />
                          <StackPanel Classes="laneValue">
                            <TextBlock Classes="laneNumber" Foreground="{StaticResource LiveVioletBrush}" Text="{Binding Live.HapticsLeftText}" />
                            <TextBlock Classes="laneNumber" Foreground="{StaticResource LiveTealBrush}" Text="{Binding Live.HapticsRightText}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <Grid Grid.Row="2" Classes="lane" ColumnDefinitions="*,Auto" IsVisible="{Binding Live.HasMic}">
                        <c:SignalTrace Name="MicTrace" Mode="Envelope" Primary="{Binding Live.MicTrace}" Revision="{Binding Live.SignalRevision}"
                                       PrimaryBrush="{StaticResource LiveAmberBrush}" />
                        <StackPanel Grid.Column="1" Classes="laneValues">
                          <TextBlock Classes="laneTitle" Text="{Binding Live.MicLabel}" />
                          <TextBlock Classes="laneNumber" Foreground="{StaticResource LiveAmberBrush}" Text="{Binding Live.MicText}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                    <!-- One muted line: what the traces cover -->
                    <TextBlock Grid.Row="1" Name="SignalsNote" Classes="caption" Text="{Binding Live.SignalsCaption}" TextWrapping="NoWrap" />
                  </Grid>
                </Panel>
              </Grid>

              <!-- No live numbers: the card keeps its title; under it one block centred in the room that is left: the chain (not
                   connected: the three steps), then a title and one short paragraph, why and what happens next -->
              <Grid Name="LiveState" IsVisible="{Binding IsNotLive}" RowDefinitions="Auto,*">
                <TextBlock Classes="h2" Text="{Binding LiveTitle}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                  <c:ChainDiagram Name="StateChain" Spec="{Binding StateChain}" />
                  <TextBlock Name="StateHeading" Classes="h2" Margin="0,20,0,0" Text="{Binding StateHeading}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Name="StateText" Classes="body" Margin="0,6,0,0" Text="{Binding StateText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Panel>
          </Border>
        </Grid>

        <!-- Quick settings: the same settings the detailed pages edit. On/off tiles first (two per row), the sound devices
             right under their tiles with the mic button's mode, then the controller's settings and the profile. One flat grid:
             the controls sit on their own rows and every gap is a row of its own (quickGap between rows, quickGroupGap between
             the groups), so a taller card (spare window height, see ElasticHeight) spreads
             over the gaps up to their caps instead of leaving one empty block. -->
        <Border Grid.Column="1" Classes="panel fill quickCard">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="0.75*" MinHeight="12" MaxHeight="16" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1.5*" MinHeight="16" MaxHeight="28" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1.5*" MinHeight="16" MaxHeight="28" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="10" MaxHeight="18" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Title, with the link to the detailed settings on the right (always inside the card) -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="{Binding Quick.Title}" />
                <TextBlock Classes="caption" Text="{Binding Quick.DisconnectedNote}" IsVisible="{Binding Quick.ShowsDisconnectedNote}" />
                <!-- Low Power on: what it turns off (the game's light, the speaker, the microphone) -->
                <TextBlock Name="LowPowerOffNote" Classes="caption" Text="{Binding Quick.LowPowerOffNote}" IsVisible="{Binding Quick.LowPowerOn}" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                <!-- The sound pickers: one line why they can't be used here, or what Windows refused -->
                <TextBlock Classes="caption" Text="{Binding Quick.Audio.UnavailableShortText}" IsVisible="{Binding Quick.Audio.ShowsUnavailable}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Quick.Audio.UnavailableText}" />
                <TextBlock Classes="caption" Foreground="{StaticResource DangerBrush}" Text="{Binding Quick.Audio.ErrorText}" IsVisible="{Binding Quick.Audio.HasError}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1" Classes="link" VerticalAlignment="Top" Command="{Binding Quick.AdvancedCommand}">
                <TextBlock Text="{Binding Quick.AdvancedText}" />
              </Button>
            </Grid>

            <!-- On/off tiles: the whole tile is the switch. Low Power is the wide one on top (while on it says what it turns off),
                 the two everyday switches under it, and Speaker and Microphone last, each right over its sound device picker.
                 Speaker is the one speaker switch; with a type that has no speaker or in Low Power it shows why it is off. The
                 Microphone tile is the mic button: a click is a press, the state word is the selected microphone's. -->
            <Grid Grid.Row="2" Classes="tiles" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
              <ToggleButton Grid.ColumnSpan="2" Name="LowPowerTile" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Leaf}" IsChecked="{Binding Quick.LowPowerOn}"
                            ToolTip.Tip="{Binding Quick.LowPowerTip}" AutomationProperties.Name="{Binding Quick.LowPowerLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.LowPowerLabel}" />
                  <TextBlock Classes="tileState" Text="{Binding Quick.LowPowerState}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Row="1" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Mouse}" IsChecked="{Binding Quick.MouseModeOn}"
                            ToolTip.Tip="{Binding Quick.MouseModeTip}" AutomationProperties.Name="{Binding Quick.MouseModeLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.MouseModeLabel}" />
                  <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                  <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                </StackPanel>
              </ToggleButton>
              <!-- Controller Shortcuts; the small button on its right opens the shortcuts list without switching -->
              <Panel Grid.Row="1" Grid.Column="1">
                <ToggleButton Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Shortcut}" IsChecked="{Binding Quick.ShortcutsOn}"
                              ToolTip.Tip="{Binding Quick.ShortcutsTip}" AutomationProperties.Name="{Binding Quick.ShortcutsLabel}">
                  <StackPanel Classes="tileText" Margin="0,0,30,0">
                    <TextBlock Classes="tileLabel" Text="{Binding Quick.ShortcutsLabel}" />
                    <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                    <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                  </StackPanel>
                </ToggleButton>
                <Button Classes="tileAction" Theme="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding Quick.EditShortcutsCommand}"
                        ToolTip.Tip="{Binding Quick.EditShortcutsTip}" AutomationProperties.Name="{Binding Quick.EditShortcutsTip}">
                  <c:IconSlot Classes="small" Data="{x:Static c:IconPaths.ChevronRight}" />
                </Button>
              </Panel>
              <ToggleButton Grid.Row="2" Name="SpeakerTile" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Speaker}" IsChecked="{Binding Quick.SpeakerOn}"
                            IsEnabled="{Binding Quick.SpeakerAvailable}" ToolTip.Tip="{Binding Quick.SpeakerTip}" AutomationProperties.Name="{Binding Quick.SpeakerLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.SpeakerLabel}" />
                  <Panel IsVisible="{Binding Quick.SpeakerAvailable}">
                    <TextBlock Classes="tileState on" Text="{Binding Quick.OnText}" />
                    <TextBlock Classes="tileState off" Text="{Binding Quick.OffText}" />
                  </Panel>
                  <TextBlock Classes="tileState" Text="{Binding Quick.SpeakerUnavailableText}" IsVisible="{Binding !Quick.SpeakerAvailable}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Row="2" Grid.Column="1" Name="MicTile" Theme="{StaticResource QuickTile}" Tag="{x:Static c:IconPaths.Microphone}" IsChecked="{Binding Quick.MicTile}"
                            IsEnabled="{Binding Quick.CanPressMic}" ToolTip.Tip="{Binding Quick.MicTip}" AutomationProperties.Name="{Binding Quick.MicLabel}">
                <StackPanel Classes="tileText">
                  <TextBlock Classes="tileLabel" Text="{Binding Quick.MicLabel}" />
                  <TextBlock Classes="tileState" Text="{Binding Quick.MicStateText}" />
                </StackPanel>
              </ToggleButton>
            </Grid>

            <!-- Sound: while headphones are plugged into the controller, the Windows default output under the Speaker tile (to send
                 game sound to them) and the microphone under the Microphone tile (the same two columns, the picker's icon under the
                 tile's); without headphones the microphone picker alone takes the whole row. Then what the mic button does. A long
                 device name is trimmed in the closed picker (the tooltip has the full one); the opened list is at least quickDevice's
                 popup width. -->
            <Grid Grid.Row="4" Classes="quickPickers" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource GapSmall}">
              <ComboBox Classes="quickDevice" Name="QuickOutputPicker" ItemsSource="{Binding Quick.Audio.Outputs}" SelectedItem="{Binding Quick.Audio.SelectedOutput}"
                        IsVisible="{Binding Quick.ShowsOutputPicker}" IsEnabled="{Binding Quick.Audio.CanChoose}" AutomationProperties.Name="{Binding Quick.Audio.OutputLabel}">
                <ToolTip.Tip>
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Quick.Audio.SelectedOutput.FullName}" IsVisible="{Binding Quick.Audio.SelectedOutput, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Quick.Audio.OutputTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <Grid Classes="deviceBox" ColumnDefinitions="Auto,*">
                      <c:IconSlot Data="{x:Static c:IconPaths.Speaker}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="{Binding Quick.MicPickerColumn}" Grid.ColumnSpan="{Binding Quick.MicPickerSpan}" Classes="quickDevice" Name="QuickInputPicker" ItemsSource="{Binding Quick.Audio.Inputs}" SelectedItem="{Binding Quick.Audio.SelectedInput}"
                        IsEnabled="{Binding Quick.Audio.CanChoose}" AutomationProperties.Name="{Binding Quick.Audio.InputLabel}">
                <ToolTip.Tip>
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Quick.Audio.SelectedInput.FullName}" IsVisible="{Binding Quick.Audio.SelectedInput, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Quick.Audio.InputTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:AudioDeviceItem">
                    <Grid Classes="deviceBox" ColumnDefinitions="Auto,*">
                      <c:IconSlot Data="{x:Static c:IconPaths.Microphone}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
            </Grid>
            <Grid Grid.Row="6" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.MicButtonTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.MicButton}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.MicButtonLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.MicButtonModes}" SelectedIndex="{Binding Quick.MicButtonModeIndex}"
                       AutomationProperties.Name="{Binding Quick.MicButtonLabel}" />
            </Grid>

            <!-- The controller type games see, the stepped settings and the profile: icon and label left, the control on the card's right edge -->
            <Grid Grid.Row="8" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.PadType.Tip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Gamepad}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.PadType.Label}" />
              <ComboBox Grid.Column="2" Name="QuickPadTypePicker" Padding="8,0,0,0" ItemsSource="{Binding Quick.PadType.Options}" SelectedItem="{Binding Quick.PadType.Selected}"
                        AutomationProperties.Name="{Binding Quick.PadType.Label}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadChoiceOption"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid Grid.Row="10" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.HapticsTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Haptics}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.HapticsLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.StrengthSteps}" SelectedIndex="{Binding Quick.HapticsIndex}"
                       AutomationProperties.Name="{Binding Quick.HapticsLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.HapticsCustom}" IsVisible="{Binding Quick.HasHapticsCustom}" />
            </Grid>
            <Grid Grid.Row="12" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.TriggerTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Trigger}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.TriggerLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.StrengthSteps}" SelectedIndex="{Binding Quick.TriggerIndex}"
                       AutomationProperties.Name="{Binding Quick.TriggerLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.TriggerCustom}" IsVisible="{Binding Quick.HasTriggerCustom}" />
            </Grid>
            <Grid Grid.Row="14" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" IsEnabled="{Binding Quick.CanEditOverridden}" ToolTip.Tip="{Binding Quick.LightTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Light}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Quick.LightLabel}" />
              <ListBox Grid.Column="2" Theme="{StaticResource Segmented}" ItemsSource="{Binding Quick.LightSteps}" SelectedIndex="{Binding Quick.LightIndex}"
                       AutomationProperties.Name="{Binding Quick.LightLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="{Binding Quick.LightCustom}" IsVisible="{Binding Quick.HasLightCustom}" />
            </Grid>
            <Grid Grid.Row="16" Classes="quickRow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Quick.ProfileTip}">
              <c:IconSlot Data="{x:Static c:IconPaths.Profile}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding ProfileLabel}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="{Binding ProfileLabel}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Health: one quiet line while everything is fine; the items (with a fix where there is one) when something needs a look -->
      <TextBlock Grid.Row="2" Classes="caption" Text="{Binding HealthSummary}" IsVisible="{Binding IsHealthAllGood}" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
      <ItemsControl Grid.Row="2" ItemsSource="{Binding HealthChips}" IsVisible="{Binding ShowsHealthChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="{StaticResource GapSmall}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HealthChipViewModel">
            <!-- A panel; when there is a fix the whole chip is its button (a "›" shows it, the tooltip names it) -->
            <Panel>
              <Border Classes="panel" Padding="12,0" Height="50" ToolTip.Tip="{Binding Reason}">
                <!-- The name has the full width (long names like "Sanal Kumanda" fit); the fix sits next to the state -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Classes="caption chipState" Classes.attention="{Binding IsAttention}" Classes.problem="{Binding IsProblem}"
                             Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasAction}">
                    <TextBlock Text="{Binding ActionText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Path Data="M1,1 L5,5 L1,9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="6" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Button Classes="chipHit" Command="{Binding RunCommand}" IsVisible="{Binding HasAction}" ToolTip.Tip="{Binding ActionTip}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    </c:ElasticHeight>
  </Border>
</UserControl>
