<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:vm="using:Kopru.App.ViewModels"
             xmlns:views="using:Kopru.App.Views"
             x:Class="Kopru.App.App"
             RequestedThemeVariant="Dark">

  <!--
    Design language: layered glass over graphite. The window uses the system acrylic backdrop when available
    (opaque graphite otherwise). Every layer above it is a FLAT translucent white fill one tint step brighter than the
    layer below (no large gradients: dark ones band), outlined by a 1 px hairline whose top edge catches a little more
    light. Gradients appear only in those hairlines. No blur, noise, glows, halos or drop shadows.

    Surface steps (white alpha over the backdrop):
      L0 window backdrop   tint only           GlassTintBrush / BackdropBrush
      L1 sidebar           #05                 SidebarBrush
      L2 cards, panels     #0D (stage #10)     PanelBrush, StageBrush
      L3 raised controls   #14 / hover #1E     QuietFillBrush, QuietFillHoverBrush (pressed #0E: sinks back)
      L4 toasts            opaque graphite     ToastBrush (own window over any desktop or game: must stay legible)
    Radius tokens: RadiusSmall 8 (inner rows, close buttons), RadiusControl 10 (buttons, inputs, nav rows),
      RadiusCard 14 (cards, toasts), RadiusStage 16 (the controller stage); pills are fully round.
    Spacing scale 4 / 8 / 12 / 16 / 20 / 24 / 32: CardPadding 20,18; PagePadding 32,28; GapSmall 8, Gap 12, GapLarge 16.
    Type scale 24 display / 18 h1 / 14 h2 / 13 body, label / 12 caption, section.
    One blue accent, used only for interactive and selected state.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- Radius, spacing and type tokens (see the header) -->
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusControl">10</CornerRadius>
      <CornerRadius x:Key="RadiusCard">14</CornerRadius>
      <CornerRadius x:Key="RadiusStage">16</CornerRadius>
      <Thickness x:Key="CardPadding">20,18</Thickness>
      <Thickness x:Key="PagePadding">32,28</Thickness>
      <x:Double x:Key="GapSmall">8</x:Double>
      <x:Double x:Key="Gap">12</x:Double>
      <x:Double x:Key="GapLarge">16</x:Double>
      <x:Double x:Key="FontDisplay">24</x:Double>
      <x:Double x:Key="FontH1">18</x:Double>
      <x:Double x:Key="FontH2">14</x:Double>
      <x:Double x:Key="FontBody">13</x:Double>
      <x:Double x:Key="FontCaption">12</x:Double>

      <!-- Surfaces, darkest to lightest -->
      <Color x:Key="K.Bg0">#141619</Color>
      <Color x:Key="K.Bg1">#1A1C20</Color>
      <Color x:Key="K.Surface">#1F2125</Color>
      <Color x:Key="K.Surface2">#272A2F</Color>
      <Color x:Key="K.Surface3">#30333A</Color>
      <Color x:Key="K.Accent">#3B82F6</Color>
      <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource K.Bg0}" />
      <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource K.Bg1}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource K.Surface}" />
      <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource K.Surface2}" />
      <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource K.Surface3}" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="BorderBrush" Color="#22FFFFFF" />
      <!-- Text: three steps, all at least 4.5:1 on the lightest translucent layer over the dark tint -->
      <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAFB7" />
      <SolidColorBrush x:Key="MutedBrush" Color="#8A909A" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#5592F7" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6FD8" />
      <!-- Light accent tint for selected chips and rows (with an accent hairline) -->
      <SolidColorBrush x:Key="AccentTintBrush" Color="#263B82F6" />
      <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#333B82F6" />
      <SolidColorBrush x:Key="IndicatorOffBrush" Color="#5F646D" />
      <SolidColorBrush x:Key="IndicatorWaitBrush" Color="#C9A24A" />
      <SolidColorBrush x:Key="IndicatorOnBrush" Color="#4FA877" />
      <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
      <!-- Toast card (L4): opaque graphite like a Windows 11 flyout, since it sits over any desktop or game and never
           gets the system acrylic (an inactive window shows the acrylic's solid fallback); same hairline family as the panels -->
      <SolidColorBrush x:Key="ToastBrush" Color="#FF232529" />
      <SolidColorBrush x:Key="ToastHoverBrush" Color="#FF2A2C31" />
      <LinearGradientBrush x:Key="ToastEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
      </LinearGradientBrush>

      <!-- L0 window backdrop: flat on purpose (gradients this dark band visibly). Opaque graphite without the system
           acrylic, a uniform translucent tint over it with -->
      <SolidColorBrush x:Key="BackdropBrush" Color="#16181C" />
      <SolidColorBrush x:Key="GlassTintBrush" Color="#A0101216" />
      <!-- L1 sidebar: one faint step above the backdrop, split from the content by a hairline -->
      <SolidColorBrush x:Key="SidebarBrush" Color="#05FFFFFF" />
      <!-- L2 glass panels and the stage behind the controller; the edge is a hairline brighter at the top -->
      <SolidColorBrush x:Key="PanelBrush" Color="#0DFFFFFF" />
      <LinearGradientBrush x:Key="PanelEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="StageBrush" Color="#10FFFFFF" />
      <!-- L3 controls: flat fills, the same top-lit hairline -->
      <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#5592F7" />
      <SolidColorBrush x:Key="QuietFillBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="QuietFillHoverBrush" Color="#1EFFFFFF" />
      <SolidColorBrush x:Key="QuietFillPressedBrush" Color="#0EFFFFFF" />
      <!-- Sidebar rows: nothing at rest, a faint fill on hover, the selected row one step brighter -->
      <SolidColorBrush x:Key="NavHoverBrush" Color="#0CFFFFFF" />
      <SolidColorBrush x:Key="NavPressedBrush" Color="#08FFFFFF" />
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#14FFFFFF" />
      <LinearGradientBrush x:Key="ControlEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
      </LinearGradientBrush>
      <!-- Accent button edge: a slightly lighter top line on the flat accent -->
      <LinearGradientBrush x:Key="AccentEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="MeterBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#2F6FD8" Offset="0" />
        <GradientStop Color="#7AB0FF" Offset="1" />
      </LinearGradientBrush>

      <!-- Semi palette overrides (dark only) -->
      <SolidColorBrush x:Key="SemiColorPrimary" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#5592F7" />
      <SolidColorBrush x:Key="SemiColorPrimaryPressed" Color="#2F6FD8" />
      <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#2F6FD8" />
      <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#263B82F6" />
      <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#333B82F6" />
      <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#403B82F6" />
      <!-- Toggle switches: accent when on (Semi uses green) -->
      <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#5592F7" />
      <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#2F6FD8" />
      <!-- A disabled switch that is on stays blue (its row dims it) -->
      <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDisabledBackground" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="SemiColorFocusBorder" Color="{StaticResource K.Accent}" />
      <SolidColorBrush x:Key="SemiColorBackground0" Color="{StaticResource K.Bg0}" />
      <SolidColorBrush x:Key="SemiColorBackground1" Color="{StaticResource K.Bg1}" />
      <SolidColorBrush x:Key="SemiColorBackground2" Color="{StaticResource K.Surface}" />
      <SolidColorBrush x:Key="SemiColorBackground3" Color="{StaticResource K.Surface2}" />
      <SolidColorBrush x:Key="SemiColorBackground4" Color="{StaticResource K.Surface3}" />
      <SolidColorBrush x:Key="SemiColorWindow" Color="{StaticResource K.Bg0}" />
      <SolidColorBrush x:Key="SemiColorBorder" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="SemiColorFill0" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="SemiColorFill1" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SemiColorFill2" Color="#1CFFFFFF" />
      <SolidColorBrush x:Key="SemiColorText0" Color="#E8EAED" />
      <SolidColorBrush x:Key="SemiColorText1" Color="#C6CAD0" />
      <SolidColorBrush x:Key="SemiColorText2" Color="#AAAFB7" />
      <SolidColorBrush x:Key="SemiColorText3" Color="#8A909A" />

      <!-- Primary action: flat accent, compact, a faint lit top edge. Focus (keyboard) = white hairline; disabled fades. -->
      <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{StaticResource AccentFillHoverBrush}" /></Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource AccentPressedBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource TextBrush}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
        <!-- Stop: same size, neutral -->
        <Style Selector="^.quiet">
          <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^.quiet:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" /></Style>
        <Style Selector="^.quiet:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
        <Style Selector="^.quiet:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
      </ControlTheme>

      <!-- Secondary action: neutral fill with a top-lit hairline; pressed sinks below rest; focus = accent hairline -->
      <ControlTheme x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" /></Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
      </ControlTheme>

      <!-- Sidebar navigation row: nothing at rest, a faint fill on hover; the selected page sits on a lit glass row with a
           short accent bar at its left edge (the only accent in the sidebar list) -->
      <ControlTheme x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusControl}">
                <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              </Border>
              <Border Name="PART_Indicator" Width="3" Height="16" CornerRadius="1.5" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{StaticResource AccentBrush}" IsVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource NavHoverBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource NavPressedBrush}" /></Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Indicator"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
      </ControlTheme>

      <!-- Selectable option (trigger effects): a panel; hover lifts it one step; the selected one gets an accent edge -->
      <ControlTheme x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillBrush}" /></Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /></Style>
      </ControlTheme>

      <!-- Chip: a small toggle for a setting; on = accent edge and a light accent tint -->
      <ControlTheme x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" /></Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^:checked:pointerover"><Setter Property="Background" Value="{StaticResource AccentTintHoverBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
      </ControlTheme>

      <!-- Quick toggle tile: the whole tile switches a setting. Off = quiet flat fill, muted icon; on = accent tint with an
           accent hairline and the icon in the accent. Content is the label and its state word; Tag is the icon geometry -->
      <SolidColorBrush x:Key="AccentTintEdgeBrush" Color="#733B82F6" />
      <ControlTheme x:Key="QuickTile" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource QuietFillPressedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="Auto,12,*" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Path Name="PART_Icon" Data="{TemplateBinding Tag}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeLineCap="Round"
                      StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" />
                <ContentPresenter Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{StaticResource QuietFillBrush}" /></Style>
        <Style Selector="^:pressed"><Setter Property="Background" Value="{StaticResource QuietFillHoverBrush}" /></Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentTintEdgeBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Path#PART_Icon"><Setter Property="Stroke" Value="{StaticResource AccentBrush}" /></Style>
        <Style Selector="^:checked:pointerover"><Setter Property="Background" Value="{StaticResource AccentTintHoverBrush}" /></Style>
        <Style Selector="^:checked:pressed"><Setter Property="Background" Value="{StaticResource AccentTintBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
      </ControlTheme>

      <!-- Segmented choice (a few steps side by side, e.g. light / normal / strong): a ListBox with this theme and string
           items; one flat track without an outline, equal steps, the selected step a raised neutral fill with full-strength
           text (still readable when its row is dimmed). SelectedIndex -1 selects none -->
      <SolidColorBrush x:Key="SegmentTrackBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#3A3F47" />
      <SolidColorBrush x:Key="SegmentSelectedHoverBrush" Color="#434852" />
      <ControlTheme x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"
                              FontWeight="{TemplateBinding FontWeight}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{StaticResource SegmentSelectedBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:selected:pointerover"><Setter Property="Background" Value="{StaticResource SegmentSelectedHoverBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="Segmented" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SegmentTrackBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentItem}" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Colour swatch: a ring marks the selected colour -->
      <ControlTheme x:Key="SwatchItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Width="32" Height="32" CornerRadius="16" BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}" Padding="4">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /></Style>
        <Style Selector="^:selected"><Setter Property="BorderBrush" Value="{StaticResource TextBrush}" /></Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:OverviewViewModel"><views:OverviewView /></DataTemplate>
    <DataTemplate DataType="vm:SupportedGamesViewModel"><views:SupportedGamesView /></DataTemplate>
    <DataTemplate DataType="vm:OtherGamesViewModel"><views:OtherGamesView /></DataTemplate>
    <DataTemplate DataType="vm:ControllerPageViewModel"><views:ControllerView /></DataTemplate>
    <DataTemplate DataType="vm:LightViewModel"><views:LightView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel"><views:SetupView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg0Brush}" />
      <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
    </Style>

    <!-- Corner radius scale: pills fully round (half their height), controls and inputs RadiusControl, cards RadiusCard,
         the controller stage RadiusStage -->
    <Style Selector="ComboBox, TextBox, NumericUpDown, AutoCompleteBox">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>

    <!-- Type scale: 24 / 18 / 14 / 13 / 12 (FontDisplay .. FontCaption) -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="{StaticResource FontH1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="{StaticResource FontH2}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <!-- Plain numeric value, right-aligned next to a slider -->
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Section heading above a card: small, semibold, Title Case, one step below the body text so it reads as a label
         of the card rather than as content -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Window backdrop -->
    <Style Selector="Border.backdrop">
      <Setter Property="Background" Value="{StaticResource BackdropBrush}" />
    </Style>
    <Style Selector="Window.glass Border.backdrop">
      <Setter Property="Background" Value="{StaticResource GlassTintBrush}" />
    </Style>
    <!-- Page body: scrolls vertically when the window is too short (pages set their own margins) -->
    <Style Selector="ScrollViewer.page">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Glass panel and the controller stage -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style Selector="Border.stage">
      <Setter Property="Background" Value="{StaticResource StageBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusStage}" />
    </Style>
    <!-- Large readout inside a stat panel -->
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Dashboard pieces: icon tile, label/value rows, read-only chip, overall status chip -->
    <Style Selector="Border.iconTile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Background" Value="{StaticResource StageBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconTile > Path, Path.icon">
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.small">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowValue">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="TextBlock.rowValue.good"><Setter Property="Foreground" Value="{StaticResource IndicatorOnBrush}" /></Style>
    <Style Selector="TextBlock.rowValue.warn"><Setter Property="Foreground" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Border.statusChip">
      <Setter Property="Background" Value="{StaticResource QuietFillBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
    </Style>
    <!-- Small static state indicator -->
    <Style Selector="Ellipse.indicator">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{StaticResource IndicatorOffBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.indicator.waiting"><Setter Property="Fill" Value="{StaticResource IndicatorWaitBrush}" /></Style>
    <Style Selector="Ellipse.indicator.on"><Setter Property="Fill" Value="{StaticResource IndicatorOnBrush}" /></Style>

    <Style Selector="Slider">
      <Setter Property="Minimum" Value="0" />
    </Style>
    <Style Selector="ProgressBar.meter">
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource MeterBrush}" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Styles>
</Application>
